<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Couleurs ──────────────────────────────────────────────────── -->
    <Color x:Key="BackgroundColor">#0D0F14</Color>
    <Color x:Key="SurfaceColor">#151820</Color>
    <Color x:Key="Surface2Color">#1C1F2B</Color>
    <Color x:Key="AccentColor">#00E5A0</Color>
    <Color x:Key="Accent2Color">#E5A000</Color>
    <Color x:Key="TextColor">#C8D0E0</Color>
    <Color x:Key="DimTextColor">#5A6275</Color>
    <Color x:Key="BorderColor">#252A38</Color>
    <Color x:Key="HighlightRowColor">#1A3A2A</Color>
    <Color x:Key="NoteColor">#70D8FF</Color>
    <Color x:Key="InstrColor">#FFD070</Color>
    <Color x:Key="EffectColor">#FF8C70</Color>

    <SolidColorBrush x:Key="BackgroundBrush"   Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"     Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"      Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="DimTextBrush"      Color="{StaticResource DimTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="HighlightRowBrush" Color="{StaticResource HighlightRowColor}"/>
    <SolidColorBrush x:Key="NoteBrush"         Color="{StaticResource NoteColor}"/>
    <SolidColorBrush x:Key="InstrBrush"        Color="{StaticResource InstrColor}"/>
    <SolidColorBrush x:Key="EffectBrush"       Color="{StaticResource EffectColor}"/>

    <!-- ── Fonts ─────────────────────────────────────────────────────── -->
    <!-- Courier New ou Consolas disponibles sans installation -->
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UIFont">Segoe UI</FontFamily>

    <!-- ── Base Window ───────────────────────────────────────────────── -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
    </Style>

    <!-- ── Boutons ───────────────────────────────────────────────────── -->
    <Style TargetType="Button" x:Key="TrackerButton">
        <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
        <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="14,6"/>
        <Setter Property="FontFamily"   Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#252A38"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#0D3028"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource TrackerButton}">
        <Setter Property="Background"  Value="#0D3028"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <!-- ── Slider ────────────────────────────────────────────────────── -->
    <Style TargetType="Slider" x:Key="TrackerSlider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- ── ScrollViewer ──────────────────────────────────────────────── -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ── ListBox ────────────────────────────────────────────────────── -->
    <Style TargetType="ListBox" x:Key="TrackerListBox">
        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="FontFamily"  Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="ListBoxItem" x:Key="TrackerListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="4,2"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A3A2A"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1C2030"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── TextBlock labels ───────────────────────────────────────────── -->
    <Style TargetType="TextBlock" x:Key="LabelText">
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
        <Setter Property="FontSize"   Value="10"/>
        <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="ValueText">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="AccentValue">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Séparateur ─────────────────────────────────────────────────── -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Margin"     Value="0,4"/>
    </Style>

    <!-- ── ProgressBar ────────────────────────────────────────────────── -->
    <Style TargetType="ProgressBar" x:Key="ChannelBar">
        <Setter Property="Height"     Value="8"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Minimum"    Value="0"/>
        <Setter Property="Maximum"    Value="64"/>
    </Style>

</ResourceDictionary>
