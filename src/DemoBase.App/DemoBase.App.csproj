<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DemoBase.App</RootNamespace>
    <AssemblyTitle>DemoBase</AssemblyTitle>
    <Company>Scene Archive</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <ApplicationIcon>DemoBase.ico</ApplicationIcon>
    <!-- StartupObject non nécessaire : App.xaml déclare x:Class="DemoBase.App.App"
         et le SDK WPF génère Main automatiquement depuis ApplicationDefinition -->
  </PropertyGroup>

  <ItemGroup>
    <!-- DI + hosting -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Markdig" Version="0.38.0" />

    <!-- MVVM toolkit (source generators, ObservableObject, RelayCommand) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.0" />

    <!-- Audio: MOD/S3M/IT/XM + MP3/FLAC/WAV -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Flac" Version="1.0.0">
      <NoWarn>NU1701;NU1603</NoWarn>
    </PackageReference>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- ModPlug / OpenMPT pour les formats tracker -->
    <PackageReference Include="LibOpenMPT.NET" Version="0.7.0" >
      <NoWarn>NU1603</NoWarn>
    </PackageReference>

    <!-- Vidéo via VLC -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <!-- Affichage images / thumbnails -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.7" />

    <!-- Reconstruction de releases : extraction d'archives diverses (étape C) -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SevenZipExtractor" Version="1.0.19" />

    <!-- Scan ROMs (2026-07-28) : décompression .zst — ni SharpZipLib ni SevenZipExtractor
         (7z.dll standard) ne savent lire le format Zstandard. Port managé pur (pas de DLL
         native à déployer), suffisant ici puisqu'on ne fait que décompresser. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoBase.Core\DemoBase.Core.csproj" />
    <ProjectReference Include="..\DemoBase.Data\DemoBase.Data.csproj" />
    <ProjectReference Include="..\DemoBase.Import\DemoBase.Import.csproj" />
    <ProjectReference Include="..\DemoBase.Media\DemoBase.Media.csproj" />
    <ProjectReference Include="..\..\TrackerPlayer.Core\TrackerPlayer.Core.csproj" />
    <ProjectReference Include="..\..\TrackerPlayer.UI\TrackerPlayer.UI.csproj" />
  </ItemGroup>

  <!-- Pas de déclaration manuelle App.xaml / MainWindow.xaml :
       UseWPF=true les détecte automatiquement via les conventions SDK.
       App.xaml est reconnu comme ApplicationDefinition car il contient
       x:Class héritant de Application. MainWindow.xaml est une Page standard. -->

  <ItemGroup>
    <Resource Include="Assets\PlatformIcons\*.png"/>
    <Resource Include="Assets\SplashScreen.png"/>
    <Resource Include="DemoBase.ico"/>
  </ItemGroup>

  <!-- DLL native de lecture des fichiers SNDH (Atari ST), compilée depuis la lib
       AtariAudio de sndh-player. Copiée À LA RACINE du répertoire de sortie
       (à côté de DemoBase.App.exe) via <Link>, car le loader Windows ne résout
       DllImport("SndhPlayer.dll") que depuis le dossier de l'exe. -->
  <ItemGroup>
    <Content Include="Native\SndhPlayer.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SndhPlayer.dll</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Template unreal.ini pour le profil machine "TSL" (ZX Evolution / TS-Config) de
       UnrealSpeccy — fourni par l'utilisateur, contient les sections ROM/ZC/HDD/BETA128
       nécessaires (rom\zxevo.rom, wc.img, boot.$b) absentes de l'unreal.ini par défaut du
       téléchargement. Lu par UnrealSpeccyLauncher.PrepareIni au lieu de l'unreal.ini du
       dossier de l'émulateur quand Machine=="TSL". -->
  <ItemGroup>
    <Content Include="Assets\UnrealSpeccy_TSL.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- NVRAM/CMOS pré-configurés pour UnrealSpeccy (machine ATM3/TSL, firmware ZX-Evolution
       "EVO Reset Service") — fournis par l'utilisateur après avoir activé une fois, à la main,
       "L.Emu tape load: On" dans ce menu (réglage stocké par l'émulateur dans ces fichiers
       binaires, propres à sa ROM zxevo.rom, pas dans unreal.ini). Copiés par
       UnrealSpeccyClassicBuildService (install) et en filet par UnrealSpeccyLauncher (lancement)
       vers Emus\Unreal Speccy\NVRAM et \CMOS, pour que la démo démarre directement sans passer
       par ce menu — cf. UnrealSpeccyClassicBuildService pour le détail. -->
  <ItemGroup>
    <Content Include="Assets\UnrealSpeccy_NVRAM">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\UnrealSpeccy_CMOS">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- settings.json pré-rempli pour Mesen (MesenCE) — dump réel généré par l'utilisateur en
       validant une fois l'assistant "MesenCE - Emulator Configuration" du premier lancement
       (stockage "same folder as the application", mappings gamepad + flèches clavier,
       pas de raccourci bureau, pas de vérification auto des mises à jour). Copié par
       MesenSetupService (install + filet au lancement) pour que cet assistant n'apparaisse
       plus jamais sur une nouvelle installation : Mesen ne le montre que si aucun settings.json
       n'existe déjà à l'emplacement attendu. -->
  <ItemGroup>
    <Content Include="Assets\Mesen_settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ecs.bin (BIOS de l'extension ECS - Entertainment Computer System) pour jzIntv, requis par
       certaines productions Intellivision en plus de exec.bin/grom.bin. Absent du pack BIOS
       Recalbox — fourni directement par l'utilisateur. Copié par BiosPackService
       (DeployEmbeddedJzIntvEcs) vers Emus\jzIntv\bin\ecs.bin, à côté de jzIntv.exe. -->
  <ItemGroup>
    <Content Include="Assets\JzIntv_ecs.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- PCSX2.ini de référence (mode portable) — fourni par l'utilisateur depuis une vraie
       session PCSX2 fonctionnelle (BIOS Europe sélectionné). Un ini généré uniquement à partir
       de quelques clés (Bios/Filenames) via UpdateIniValue ne suffit pas : PCSX2 refuse un
       fichier incomplet ("Settings failed to load, or are the incorrect version"). Copié tel
       quel par BiosPackService (ConfigurePcsx2) vers Emus\PCSX2\inis\PCSX2.ini UNIQUEMENT si ce
       fichier n'existe pas déjà (1ère installation) — ne touche jamais à un ini existant/déjà
       personnalisé par l'utilisateur au-delà des clés Bios/Filenames. -->
  <ItemGroup>
    <Content Include="Assets\Pcsx2_PCSX2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
