<Window x:Class="DemoBase.App.EmulatorDownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DemoBase.App.Views"
        Title="DemoBase — Emulator Download Manager"
        Width="820" Height="640"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Grid.RowSpan="2" Margin="0">
            <TabItem Header="Emulators">
                <views:EmulatorInstallerView x:Name="EmulatorsView"/>
            </TabItem>
            <TabItem Header="External tools">
                <views:EmulatorInstallerView x:Name="ExternalsView"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
