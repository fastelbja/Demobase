<Window x:Class="DemoBase.App.RomScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemoBase — Scan for Releases" Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="{DynamicResource BgApp}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DemoBase" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource ScanRoms_Subtitle}" FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Barre de progression globale -->
            <ProgressBar x:Name="GlobalProgress" Grid.Row="2" Height="4" BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"
                         Margin="0,0,0,10" Minimum="0" Maximum="100"/>

            <!-- Fichier en cours -->
            <TextBlock x:Name="CurrentFileText" Grid.Row="3"
                       FontSize="10" FontFamily="Courier New"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Stats -->
            <TextBlock x:Name="StatsText" Grid.Row="4" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- Progression au sein de l'archive en cours (2026-07-28, demande utilisateur) —
                 visible uniquement pendant le traitement d'une archive potentiellement
                 volumineuse. Indéterminée pendant l'extraction (pas de callback disponible),
                 puis pourcentage réel entrée/total pendant la comparaison des fichiers extraits. -->
            <Border Grid.Row="5" x:Name="ArchivePanel" Visibility="Collapsed" Margin="0,4,0,12">
                <StackPanel>
                    <TextBlock x:Name="ArchiveLabelText" FontSize="10" FontFamily="Courier New"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <ProgressBar x:Name="ArchiveProgress" Height="3" BorderThickness="0"
                                 Foreground="{DynamicResource TextSecondary}"
                                 Background="{DynamicResource BgHover}"
                                 Minimum="0" Maximum="100"/>
                </StackPanel>
            </Border>

            <!-- Résultat : releases complétées pendant ce scan -->
            <Border Grid.Row="6" x:Name="ResultsPanel" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6" Background="{DynamicResource BgHover}">
                <ListBox x:Name="CompletedList" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextSecondary}" FontSize="11"
                         FontFamily="Courier New" Padding="6"/>
            </Border>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource ScanRoms_Cancel}"
                        Style="{StaticResource IconButton}" Padding="18,7"
                        Click="OnCancelClick" Margin="0,0,10,0"/>
                <Button x:Name="CloseButton" Content="{DynamicResource ScanRoms_Close}"
                        Style="{StaticResource AccentButton}" Padding="18,7"
                        Visibility="Collapsed" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
