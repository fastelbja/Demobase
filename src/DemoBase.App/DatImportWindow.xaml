<Window x:Class="DemoBase.App.DatImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemoBase — Import DAT" Height="220" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="{DynamicResource BgApp}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="8">
        <StackPanel Margin="32,28">
            <TextBlock Text="DemoBase" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Dat_Updating}" FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Barre de progression globale -->
            <ProgressBar x:Name="GlobalProgress" Height="4" BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"
                         Margin="0,0,0,10" Minimum="0" Maximum="100"/>

            <!-- Fichier en cours -->
            <TextBlock x:Name="CurrentFileText"
                       FontSize="10" FontFamily="Courier New"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Stats -->
            <TextBlock x:Name="StatsText" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
