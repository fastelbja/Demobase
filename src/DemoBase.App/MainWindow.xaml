<Window x:Class="DemoBase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:DemoBase.App.Controls"
             xmlns:app="clr-namespace:DemoBase.App"
        xmlns:vr="clr-namespace:DemoBase.App.ViewModels.Releases"
        xmlns:views="clr-namespace:DemoBase.App.Views.Releases"
        xmlns:viewsr="clr-namespace:DemoBase.App.Views.Releasers"
        xmlns:viewsp="clr-namespace:DemoBase.App.Views.Parties"
        xmlns:viewsl="clr-namespace:DemoBase.App.Views.Library"
        xmlns:viewse="clr-namespace:DemoBase.App.Views.Emulators"
        xmlns:vme="clr-namespace:DemoBase.App.ViewModels.Emulators"
        xmlns:vmlib="clr-namespace:DemoBase.App.ViewModels.Library"
        xmlns:viewsmedia="clr-namespace:DemoBase.App.Views.Media"
        xmlns:viewsset="clr-namespace:DemoBase.App.Views.Settings"
             xmlns:views2="clr-namespace:DemoBase.App.Views"
             xmlns:vmfav="clr-namespace:DemoBase.App.ViewModels"
        Title="DemoBase"
        Icon="DemoBase.ico"
        MinWidth="1200" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgApp}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmfav:GraphicsViewerViewModel}">
            <views:GraphicsViewerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmfav:CodeSourceViewerViewModel}">
            <views:CodeSourceViewerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vr:ReleaseListViewModel}">
            <views:ReleaseListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vr:ReleaseEditViewModel}">
            <views:ReleaseEditView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmlib:GroupListViewModel}">
            <viewsl:GroupListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmlib:ScenerListViewModel}">
            <viewsl:ScenerListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmlib:PlatformListViewModel}">
            <viewsl:PlatformListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmlib:PartyListViewModel}">
            <viewsl:PartyListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vme:EmulatorSettingsViewModel}">
            <viewse:EmulatorSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmfav:FavoriteSoundtracksViewModel}">
            <views2:FavoriteSoundtracksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmfav:MediaBrowserViewModel}">
            <viewsmedia:MediaBrowserView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmfav:FavoriteGraphicsViewModel}">
            <views2:FavoriteGraphicsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:PreferencesViewModel}">
            <viewsset:PreferencesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vr:ReleaserDetailViewModel}">
            <viewsr:ReleaserDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vr:PartyDetailViewModel}">
            <viewsp:PartyDetailView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160" MaxWidth="260"/>
            <ColumnDefinition Width="1"/>
            <!-- Zone centrale : 50% de l'espace dispo -->
            <ColumnDefinition x:Name="CenterColumn" Width="*" MinWidth="200"/>
            <ColumnDefinition x:Name="RightSeparator" Width="1"/>
            <!-- Colonne droite : 50% de l'espace dispo -->
            <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14,16,12"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DemoBase" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{x:Static app:DebugHelper.AppVersion}"
                                       FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Scene Archive Manager" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Zone d'effet démo (cliquable pour changer) -->
                        <ctrl:DemoEffectControl x:Name="DemoEffect"
                                                Height="160"
                                                Visibility="Collapsed"/>
                        <!-- Bouton toggle -->
                        <Button x:Name="BtnDemoToggle" Style="{StaticResource IconButton}"
                                Content="{DynamicResource Nav_DemoEffects}"
                                HorizontalAlignment="Stretch" Padding="10,6"
                                Click="BtnDemoToggle_Click"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="10,8"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Button x:Name="BtnAbout" Style="{StaticResource IconButton}"
                            Content="ℹ À propos" Click="BtnAbout_Click"
                            HorizontalAlignment="Stretch"/>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="10,8"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Button x:Name="BtnTheme" Style="{StaticResource IconButton}"
                            Content="{DynamicResource Nav_Theme}" Click="BtnTheme_Click"
                            HorizontalAlignment="Stretch"/>
                </Border>

                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="6,8">
                    <StackPanel>

                        <!-- ── BIBLIOTHÈQUE ───────────────────────────────── -->
                        <TextBlock Text="{DynamicResource Nav_Library}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="10,4,0,6"/>
                        <ItemsControl ItemsSource="{Binding LibraryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Command}"
                                            Style="{StaticResource IconButton}"
                                            HorizontalContentAlignment="Left"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,1" Padding="10,7"
                                            BorderThickness="0">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource HRule}" Margin="10,8"/>

                        <!-- ── FAVORIS ────────────────────────────────────── -->
                        <TextBlock Text="{DynamicResource Nav_FavoritesSection}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding FavoritesItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Command}"
                                            Style="{StaticResource IconButton}"
                                            HorizontalContentAlignment="Left"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,1" Padding="10,7"
                                            BorderThickness="0">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource HRule}" Margin="10,8"/>
                        <TextBlock Text="{DynamicResource Nav_MediaSection}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding MediaItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Command}"
                                            Style="{StaticResource IconButton}"
                                            HorizontalContentAlignment="Left"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,1" Padding="10,7"
                                            BorderThickness="0">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource HRule}" Margin="10,8"/>

                        <TextBlock Text="{DynamicResource Nav_Management}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="10,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ManagementItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Command}"
                                            Style="{StaticResource IconButton}"
                                            HorizontalContentAlignment="Left"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,1" Padding="10,7"
                                            BorderThickness="0">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── Bouton mise à jour Demozoo (visible seulement si update dispo) ── -->
                        <Button Command="{Binding DownloadDemozooUpdateCommand}"
                                Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0" Padding="10,8"
                                BorderThickness="0"
                                ToolTip="{Binding DemozooUpdateLabel}">
                            <Button.Visibility>
                                <Binding Path="HasDemozooUpdate"
                                         Converter="{StaticResource BoolToVisibility}"/>
                            </Button.Visibility>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource Accent}"
                                        CornerRadius="8" Padding="5,2" Margin="0,0,7,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="↑" FontSize="11" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Nav_DemozooUpdate}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding DemozooUpdateLabel}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Bouton debug Export Demozoo Raw -->
                        <Button Style="{StaticResource IconButton}"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0" Padding="10,7"
                                BorderThickness="0"
                                Command="{Binding ExportDemozooRawCommand}">
                            <Button.Visibility>
                                <Binding Source="{x:Static app:DebugHelper.IsDebugMode}"
                                         Converter="{StaticResource BoolToVisibility}"/>
                            </Button.Visibility>
                            <TextBlock Text="{DynamicResource App_ExportRaw}"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="11"/>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Border}"/>

        <!-- ── Zone centrale : listes + détails groupes/parties ───── -->
        <Grid Grid.Column="2" Background="{DynamicResource BgApp}">
            <!-- Vues Singleton maintenues en mémoire via ZIndex -->
            <viewsl:GroupListView  x:Name="GroupListViewInst"
                                   Panel.ZIndex="0" IsHitTestVisible="False"/>
            <viewsl:ScenerListView x:Name="ScenerListViewInst"
                                   Panel.ZIndex="0" IsHitTestVisible="False"/>
            <viewsl:PartyListView  x:Name="PartyListViewInst"
                                   Panel.ZIndex="0" IsHitTestVisible="False"/>
            <viewsr:ReleaserDetailView x:Name="ReleaserDetailViewInst"
                                       Panel.ZIndex="0" IsHitTestVisible="False"/>
            <viewsp:PartyDetailView    x:Name="PartyDetailViewInst"
                                       Panel.ZIndex="0" IsHitTestVisible="False"/>
            <!-- ContentControl pour toutes les autres vues (ReleaseList, Prefs, Emulators…) -->
            <ContentControl x:Name="MainContent"
                            Panel.ZIndex="1"
                            Background="{DynamicResource BgApp}"/>
        </Grid>

        <Border Grid.Column="3" Background="{DynamicResource Border}"/>

        <!-- ── Colonne droite : fiche Release toujours visible ───── -->
        <Border Grid.Column="4" Background="{DynamicResource BgApp}">
            <views:ReleaseDetailView x:Name="ReleaseDetailViewInst"/>
        </Border>

        <!-- ── Status Bar (sinus scroller) ────────────────────────────── -->
        <ctrl:StatusScrollerControl Grid.Row="1" Grid.ColumnSpan="5"
                                    x:Name="StatusScroller"/>
    </Grid>
</Window>
