<UserControl x:Class="DemoBase.App.Views.Emulators.ViceC64DtvSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="VICE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_ViceC64DtvConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Région / révision -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_VideoStandard}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Region}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="PAL (défaut)" Tag="pal"/>
                        <ComboBoxItem Content="NTSC"         Tag="ntsc"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_DtvRevision}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding DtvRevision}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="DTV2"          Tag="2"/>
                        <ComboBoxItem Content="DTV3 (défaut)" Tag="3"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Lecteur -->
            <CheckBox Content="{DynamicResource Emu_TrueDrive}" IsChecked="{Binding TrueDrive}" Margin="0,12,0,4"/>
            <TextBlock Text="{DynamicResource Emu_TrueDriveHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_ViceFullscreen}" IsChecked="{Binding FullScreen}"/>

        </StackPanel>
    </Border>
</UserControl>
