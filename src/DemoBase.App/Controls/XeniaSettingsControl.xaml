<UserControl x:Class="DemoBase.App.Views.Emulators.XeniaSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Xenia" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Xbox 360" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- GPU Backend -->
            <TextBlock Text="GPU Backend (--gpu)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:XeniaSettingsViewModel.GpuOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Gpu}"
                      SelectedValuePath="Value"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,6"/>
            <CheckBox Content="VSync (désactiver peut réduire l'input lag)"
                      IsChecked="{Binding VSync}" Margin="0,0,0,12"/>

            <!-- Info formats -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Formats &amp; structure" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text=".xex (recommandé) — .iso — .zar. Pour les jeux Xbox Live Arcade, passer le fichier exécutable (sans extension) dans la hiérarchie TitleID/ContentType/Hash. Le fichier vient toujours en premier dans la commande Xenia."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
