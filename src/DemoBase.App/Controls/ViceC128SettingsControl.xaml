<UserControl x:Class="DemoBase.App.Views.Emulators.ViceC128SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="VICE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_ViceC128Config}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Région -->
            <TextBlock Text="{DynamicResource Emu_VideoStandard}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding Region}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="PAL (défaut)" Tag="pal"/>
                <ComboBoxItem Content="NTSC"         Tag="ntsc"/>
            </ComboBox>

            <!-- SID -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_SidEngine}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding SidEngine}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="ReSID (défaut, précis)"   Tag="1"/>
                        <ComboBoxItem Content="FastSID (rapide)"        Tag="0"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_SidModel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding SidModel}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="MOS 6581 (défaut)"        Tag="0"/>
                        <ComboBoxItem Content="MOS 8580"                Tag="1"/>
                        <ComboBoxItem Content="MOS 8580 + digiboost"    Tag="2"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- REU -->
            <TextBlock Text="{DynamicResource Emu_Memory}" Style="{StaticResource FieldLabel}" Margin="0,12,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource Emu_Reu}" IsChecked="{Binding Reu}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              IsEnabled="{Binding Reu}"
                              SelectedValue="{Binding ReuSize}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="128 Kio"           Tag="128"/>
                        <ComboBoxItem Content="256 Kio"           Tag="256"/>
                        <ComboBoxItem Content="512 Kio (défaut)"  Tag="512"/>
                        <ComboBoxItem Content="1024 Kio"          Tag="1024"/>
                        <ComboBoxItem Content="2048 Kio"          Tag="2048"/>
                        <ComboBoxItem Content="4096 Kio"          Tag="4096"/>
                        <ComboBoxItem Content="16384 Kio"         Tag="16384"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Mode démarrage / colonnes -->
            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox Content="{DynamicResource Emu_Go64}" IsChecked="{Binding Go64}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Emu_Go64Hint}" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_Columns}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Columns}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="40 colonnes"          Tag="40"/>
                        <ComboBoxItem Content="80 colonnes (défaut)" Tag="80"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Lecteur -->
            <CheckBox Content="{DynamicResource Emu_TrueDrive}" IsChecked="{Binding TrueDrive}" Margin="0,12,0,4"/>
            <TextBlock Text="{DynamicResource Emu_TrueDriveHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_ViceFullscreen}" IsChecked="{Binding FullScreen}"/>

        </StackPanel>
    </Border>
</UserControl>
