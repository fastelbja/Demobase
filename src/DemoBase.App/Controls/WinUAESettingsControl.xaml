<UserControl x:Class="DemoBase.App.Views.Emulators.WinUAESettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="WinUAE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Amiga (WinUAE)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- ROM Kickstart -->
            <TextBlock Text="ROM Kickstart" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="📂" Padding="10,6" Margin="6,0,0,0"
                        Command="{Binding BrowseKickstartCommand}"/>
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding KickstartPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" Padding="8,6"
                         FontFamily="{StaticResource FontMono}" FontSize="11"/>
            </DockPanel>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="ROM Kickstart (kick13.rom, kick20.rom, kick31.rom…). Obligatoire pour lancer sans afficher l'interface WinUAE. Peut aussi être configurée dans WinUAE (Settings → Paths → ROM file)."/>

            <!-- Moniteur cible -->
            <TextBlock Text="Moniteur (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" Text="gfx_display" Width="180"
                           FontFamily="{StaticResource FontMono}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding UaeDisplayIndex, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="11"
                         ToolTip="Index du moniteur (ex. 2). Correspond à gfx_display dans le .uae."/>
            </DockPanel>

            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" Text="gfx_display_friendlyname" Width="180"
                           FontFamily="{StaticResource FontMono}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding UaeDisplayFriendly, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="11"
                         ToolTip="Nom affiché du moniteur (ex. Generic PnP Monitor)."/>
            </DockPanel>

            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="gfx_display_name" Width="180"
                           FontFamily="{StaticResource FontMono}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding UaeDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="11"
                         ToolTip="Nom registre du moniteur (ex. \Registry\Machine\System\...)."/>
            </DockPanel>

            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Left" FontSize="10"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                           Text="Copier les 3 valeurs depuis votre .uae WinUAE. Laisser vide = moniteur par défaut."/>
                <Button DockPanel.Dock="Right"
                        Content="Appliquer à toutes les configs"
                        Padding="10,5" Margin="8,0,0,0"
                        Style="{StaticResource IconButton}"
                        Command="{Binding ApplyDisplayToAllConfigsCommand}"
                        IsEnabled="{Binding IsApplyingToAll, Converter={x:Static vm:InverseBooleanConverter.Instance}}"/>
            </DockPanel>
            <TextBlock FontSize="10" Foreground="{DynamicResource Accent}"
                       Text="{Binding SaveMessage}"
                       Visibility="{Binding SaveMessage, Converter={StaticResource NullToVisibility}}"
                       Margin="0,0,0,12"/>

            <!-- CPU options — cases "Cycle-exact (Full)" / "Cycle-exact (DMA/Memory accesses)"
                 du dialogue "CPU options" de WinUAE (cpu_cycle_exact / cpu_memory_cycle_exact
                 dans le .uae). "Auto" laisse le .uae de base inchangé ; Activé/Désactivé force
                 la valeur — évite d'avoir à dupliquer un .uae juste pour ces 2 cases. -->
            <TextBlock Text="CPU options" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cycle-exact (Full)" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding CycleExact}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (.uae de base)" Tag="auto"/>
                        <ComboBoxItem Content="Activé"              Tag="true"/>
                        <ComboBoxItem Content="Désactivé"           Tag="false"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cycle-exact (DMA/Memory)" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding MemoryCycleExact}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (.uae de base)" Tag="auto"/>
                        <ComboBoxItem Content="Activé"              Tag="true"/>
                        <ComboBoxItem Content="Désactivé"           Tag="false"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="cpu_cycle_exact / cpu_memory_cycle_exact dans le .uae. &quot;Auto&quot; = valeur du .uae de base inchangée."/>

            <!-- .uae de base -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Config .uae de base (optionnel)" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="Dans le champ &quot;Command Line&quot; du profil (ci-dessus), saisissez le chemin vers votre .uae de référence. Exemple : C:\WinUAE\Configurations\A500-OCS.uae"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="DemoBase l'utilise comme base et y injecte les disques extraits du ZIP automatiquement (A→B→C ou 1→2→3). Sans ce fichier, seule la ROM Kickstart ci-dessus est utilisée."/>
                </StackPanel>
            </Border>

            <!-- Info multi-disques -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="Multi-disques : DF0=disque1, DF1=disque2, DF2=disque3, DF3=disque4. Disques 5+ accessibles via Ctrl+F11 (swap WinUAE)."/>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
