<UserControl x:Class="DemoBase.App.Views.Emulators.PuNESSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="puNES" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="NES / Famicom / FDS / NSF" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,10"/>

            <!-- Échelle -->
            <TextBlock Text="Échelle (mode fenêtré)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:PuNESSettingsViewModel.ScaleOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Scale}"
                      SelectedValuePath="Value"/>

            <!-- Filtre vidéo -->
            <TextBlock Text="Filtre vidéo" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:PuNESSettingsViewModel.FilterOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Filter}"
                      SelectedValuePath="Value"/>

            <!-- Options -->
            <CheckBox Content="VSync" IsChecked="{Binding VSync}" Margin="0,0,0,6"/>
            <CheckBox IsChecked="{Binding Portable}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="--portable"/>
                        <Run Text=" — configs et saves dans le répertoire de l'exe"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

        </StackPanel>
    </Border>
</UserControl>
