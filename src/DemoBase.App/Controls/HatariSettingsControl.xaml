<UserControl x:Class="DemoBase.App.Views.Emulators.HatariSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DemoBase.App.Converters">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Hatari" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_HatariConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- ROM TOS -->
            <TextBlock Text="{DynamicResource Emu_TosRom}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding TosPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBox}" Padding="8,6"/>
                <Button Grid.Column="1" Content="📂" Margin="6,0,0,0" Padding="10,6"
                        Style="{StaticResource IconButton}"
                        Command="{Binding BrowseTosCommand}"
                        ToolTip="Sélectionner le fichier ROM TOS"/>
            </Grid>
            <TextBlock Text="{DynamicResource Emu_TosRomHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,-6,0,12"
                       TextWrapping="Wrap"/>

            <!-- Machine + Moniteur -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding MachineType}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Atari ST"       Tag="st"/>
                        <ComboBoxItem Content="Atari Mega ST"  Tag="megast"/>
                        <ComboBoxItem Content="Atari STE"      Tag="ste"/>
                        <ComboBoxItem Content="Atari Mega STE" Tag="megaste"/>
                        <ComboBoxItem Content="Atari TT"       Tag="tt"/>
                        <ComboBoxItem Content="Atari Falcon"   Tag="falcon"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_Monitor}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Monitor}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="RGB/Couleur" Tag="rgb"/>
                        <ComboBoxItem Content="Monochrome"  Tag="mono"/>
                        <ComboBoxItem Content="VGA"         Tag="vga"/>
                        <ComboBoxItem Content="TV"          Tag="tv"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- CPU options — dialogue "CPU options" de Hatari (CPU type / CPU clock / FPU).
                 "Auto" = comportement historique DemoBase, déduit de la machine ci-dessus
                 (cf. HatariLauncher) ; les 3 autres valeurs forcent explicitement le réglage. -->
            <TextBlock Text="CPU options" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CPU type" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding CpuType}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (selon machine)" Tag="auto"/>
                        <ComboBoxItem Content="68000" Tag="0"/>
                        <ComboBoxItem Content="68010" Tag="1"/>
                        <ComboBoxItem Content="68020" Tag="2"/>
                        <ComboBoxItem Content="68030" Tag="3"/>
                        <ComboBoxItem Content="68040" Tag="4"/>
                        <ComboBoxItem Content="68060" Tag="5"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CPU clock" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding CpuClock}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (selon machine)" Tag="auto"/>
                        <ComboBoxItem Content="8 MHz"  Tag="8"/>
                        <ComboBoxItem Content="16 MHz" Tag="16"/>
                        <ComboBoxItem Content="32 MHz" Tag="32"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="FPU" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Fpu}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (selon machine)" Tag="auto"/>
                        <ComboBoxItem Content="None"     Tag="none"/>
                        <ComboBoxItem Content="68881"    Tag="68881"/>
                        <ComboBoxItem Content="68882"    Tag="68882"/>
                        <ComboBoxItem Content="Internal" Tag="internal"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,-6,0,12">
                68010/68040/68060 n'ont jamais équipé de vrai Atari — à réserver à des cas précis. Le 68882 n'est activé par défaut que pour la machine TT.
            </TextBlock>

            <!-- Mémoire : ST-RAM (toujours pertinent) + TT-RAM (TT/Falcon uniquement) —
                 valeurs Tag = valeur brute passée aux options memsize / ttram de Hatari
                 (cf. HatariLauncher), 256 KiB et 2.5 MiB se codant en KiB, pas en MiB direct. -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_StRam}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding StRam}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="256 KiB" Tag="256"/>
                        <ComboBoxItem Content="512 KiB" Tag="0"/>
                        <ComboBoxItem Content="1 MiB"   Tag="1"/>
                        <ComboBoxItem Content="2 MiB"   Tag="2"/>
                        <ComboBoxItem Content="2.5 MiB" Tag="2560"/>
                        <ComboBoxItem Content="4 MiB"   Tag="4"/>
                        <ComboBoxItem Content="8 MiB"   Tag="8"/>
                        <ComboBoxItem Content="10 MiB"  Tag="10"/>
                        <ComboBoxItem Content="14 MiB"  Tag="14"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_TtRam}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding TtRam}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="0 MiB (désactivé)" Tag="0"/>
                        <ComboBoxItem Content="4 MiB"             Tag="4"/>
                        <ComboBoxItem Content="8 MiB"              Tag="8"/>
                        <ComboBoxItem Content="16 MiB"             Tag="16"/>
                        <ComboBoxItem Content="32 MiB"             Tag="32"/>
                        <ComboBoxItem Content="64 MiB"             Tag="64"/>
                        <ComboBoxItem Content="128 MiB"            Tag="128"/>
                        <ComboBoxItem Content="256 MiB"            Tag="256"/>
                        <ComboBoxItem Content="512 MiB"            Tag="512"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Emu_TtRamHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,-6,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox Content="{DynamicResource Emu_HatariFullscreen}" IsChecked="{Binding FullScreen}" Margin="0,0,16,0"/>
                <CheckBox Content="{DynamicResource Emu_Borders}" IsChecked="{Binding Borders}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Content="{DynamicResource Emu_StatusBar}" IsChecked="{Binding StatusBar}" Margin="0,0,16,0"/>
                <CheckBox Content="{DynamicResource Emu_DriveLed}" IsChecked="{Binding DriveLed}"/>
            </StackPanel>

            <!-- Résolution VDI étendue — bas du dialogue "Atari monitor" de Hatari. Désactivée
                 par défaut : quasi aucune demo/jeu de la scène n'en a besoin (réservé aux
                 applis GEM), cf. manuel officiel Hatari. -->
            <CheckBox Content="Use extended VDI screen (--vdi)"
                      IsChecked="{Binding VdiEnabled}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4" IsEnabled="{Binding VdiEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Largeur" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding VdiWidth, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hauteur" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding VdiHeight, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Couleurs" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding VdiPlanes}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="2 couleurs"  Tag="1"/>
                        <ComboBoxItem Content="4 couleurs"  Tag="2"/>
                        <ComboBoxItem Content="16 couleurs" Tag="4"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock Text="Largeur : 320 à 2048 (multiple de 16) — Hauteur : 160 à 1280 (multiple de 8). Presque aucune demo/jeu de la scène n'en a besoin (résolutions GEM uniquement) — à laisser désactivé sauf cas précis."
                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,4,0,16"/>

            <!-- Performance -->
            <TextBlock Text="Performance" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox IsChecked="{Binding FastBoot}" Margin="0,0,0,6">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Boot rapide (--fast-boot)"/>
                        <Run Text=" — saute le test mémoire du TOS : démarrage bien plus rapide. À décocher pour les rares progs exigeant un boot non patché."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding TimerD}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Patch Timer-D (--timer-d)"/>
                        <Run Text=" — supprime un flot d'interruptions inutiles (≈ ×2 la vitesse d'émulation ST/STE)."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

            <!-- Paramètres CPU avancés — mêmes options que la fenêtre "CPU emulation
                 parameters" de la GUI Hatari (menu System). La plupart sont qualifiées
                 d'"expérimentales" par le manuel officiel : à ne changer que pour une
                 demo précise qui l'exige (ou pour reproduire une config Hatari existante). -->
            <TextBlock Text="Paramètres d'émulation CPU" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
            <CheckBox IsChecked="{Binding Prefetch}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Prefetch emulation (--compatible)"/>
                        <Run Text=" — mode 68000 plus compatible (précision du prefetch et des erreurs d'adresse). Nécessaire pour certaines demos à overscan/rasters. Utilise plus de CPU hôte."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding CpuExact}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Cycle-exact emulation (--cpu-exact)"/>
                        <Run Text=" — émulation CPU cycle-exacte. Utilise plus de CPU hôte."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding DataCache}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Data cache emulation (--data-cache)"/>
                        <Run Text=" — cache de données du CPU, pertinent seulement en ≥68030 (TT/Falcon). Utilise plus de CPU hôte."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding Mmu}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="MMU emulation (--mmu)"/>
                        <Run Text=" — nécessite un ≥68030 et un EmuTOS 512k/1024k ou un TOS 2.06. Utilise plus de CPU hôte."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding Addr24}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="24-bit addressing (--addr24)"/>
                        <Run Text=" — adressage 24 bits (compatible ST) au lieu de 32 bits."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <CheckBox IsChecked="{Binding FpuSoftfloat}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Accurate FPU emulation (--fpu-softfloat)"/>
                        <Run Text=" — émulation FPU logicielle bit-exacte au lieu du FPU de la machine hôte. Utilise plus de CPU hôte."
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

        </StackPanel>
    </Border>
</UserControl>
