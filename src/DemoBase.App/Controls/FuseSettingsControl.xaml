<UserControl x:Class="DemoBase.App.Views.Emulators.FuseSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Fuse" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Machine &amp; configuration" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Machine -->
            <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:FuseSettingsViewModel.MachineOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Machine}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"
                       TextWrapping="Wrap"
                       Text="Fuse ne supporte pas ZX Spectrum Next — utiliser ZEsarUX (machine TBBlue) pour les démos Next."/>

        </StackPanel>
    </Border>
</UserControl>
