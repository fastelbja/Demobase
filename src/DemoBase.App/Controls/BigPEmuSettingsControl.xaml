<UserControl x:Class="DemoBase.App.Views.Emulators.BigPEmuSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="BigPEmu" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Atari Jaguar / Jaguar CD" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Système -->
            <TextBlock Text="Système" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="Mode PAL (50 Hz) — requis pour les démos Jaguar européennes"
                      IsChecked="{Binding PalMode}" Margin="0,0,0,6"/>
            <CheckBox Content="Mode portable (-localdata) — config dans le dossier de BigPEmu"
                      IsChecked="{Binding LocalData}" Margin="0,0,0,12"/>

            <!-- Info formats -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Formats &amp; infos" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="Cartouche : .j64 .jag .rom .zip (chargement natif). CD : .cue .cdi .bigpimg. Pas de BIOS requis. Le fullscreen et les effets vidéo se configurent dans BigPEmu → Settings → Video."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
