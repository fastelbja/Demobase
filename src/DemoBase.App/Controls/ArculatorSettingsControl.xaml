<UserControl x:Class="DemoBase.App.Views.Emulators.ArculatorSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Arculator" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Machine Acorn Archimedes" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Nom du config (saisie libre) -->
            <TextBlock Text="Nom du profil machine (.cfg)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource SearchBox}"
                     Text="{Binding Config, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" FontFamily="Consolas" FontSize="12"
                     Margin="0,0,0,4"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="Doit correspondre EXACTEMENT au nom d'un fichier .cfg dans configs/ d'Arculator (sans l'extension .cfg)."/>

            <!-- Bouton scanner -->
            <Button Style="{StaticResource IconButton}"
                    Content="📂 Lister les configs disponibles"
                    Command="{Binding ScanConfigsCommand}"
                    HorizontalAlignment="Left"
                    Padding="8,4" FontSize="11" Margin="0,0,0,6"/>

            <!-- Configs trouvées -->
            <ItemsControl ItemsSource="{Binding AvailableConfigs}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAvailableConfigs}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource IconButton}"
                                Content="{Binding}"
                                FontSize="10" FontFamily="{StaticResource FontMono}"
                                HorizontalAlignment="Left" Padding="6,2" Margin="0,1"
                                Command="{Binding DataContext.SelectConfigCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Message si aucune config trouvée -->
            <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                       Text="{Binding ScanMessage}"
                       Visibility="{Binding ScanMessage, Converter={StaticResource EmptyToVisibility}}"
                       Margin="0,4,0,8"/>

            <!-- Limitation ADF -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="⚠ Arculator ne supporte pas le chargement d'un fichier ADF en ligne de commande. DemoBase lance simplement le profil — le fichier doit être accessible via ADFFS ou HostFS dans RISC OS."/>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
