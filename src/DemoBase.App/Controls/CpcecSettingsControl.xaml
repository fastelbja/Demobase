<UserControl x:Class="DemoBase.App.Views.Emulators.CpcecSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="CPCEC" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_CpcecConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Modèle + RAM -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding MachineModel}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Amstrad CPC 464"          Tag="0"/>
                        <ComboBoxItem Content="Amstrad CPC 664"          Tag="1"/>
                        <ComboBoxItem Content="Amstrad CPC 6128"         Tag="2"/>
                        <ComboBoxItem Content="Amstrad CPC Plus / GX4000" Tag="3"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_Ram}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Ram}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="64K"    Tag="0"/>
                        <ComboBoxItem Content="128K"   Tag="1"/>
                        <ComboBoxItem Content="192K"   Tag="2"/>
                        <ComboBoxItem Content="320K"   Tag="3"/>
                        <ComboBoxItem Content="576K"   Tag="4"/>
                        <ComboBoxItem Content="1088K"  Tag="5"/>
                        <ComboBoxItem Content="2112K"  Tag="6"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- CRTC -->
            <TextBlock Text="{DynamicResource Emu_CrtcType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      SelectedValue="{Binding CrtcType}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="CRTC 0" Tag="0"/>
                <ComboBoxItem Content="CRTC 1 (défaut)" Tag="1"/>
                <ComboBoxItem Content="CRTC 2" Tag="2"/>
                <ComboBoxItem Content="CRTC 3" Tag="3"/>
                <ComboBoxItem Content="CRTC 4" Tag="4"/>
            </ComboBox>
            <TextBlock Text="{DynamicResource Emu_CrtcTypeHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}" IsChecked="{Binding FullScreen}" Margin="0,0,16,0"/>
                <CheckBox Content="{DynamicResource Emu_CpcecIndicators}" IsChecked="{Binding ShowIndicators}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
