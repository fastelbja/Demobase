<UserControl x:Class="DemoBase.App.Views.Emulators.MsxecSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="MSXEC" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_MsxecConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Modèle + RAM -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding MachineModel}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="MSX (1983)"   Tag="0"/>
                        <ComboBoxItem Content="MSX2 (1985)"  Tag="1"/>
                        <ComboBoxItem Content="MSX2+ (1988)" Tag="2"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_Ram}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding Ram}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="64K (sans mapper)" Tag="0"/>
                        <ComboBoxItem Content="64K (avec mapper)" Tag="1"/>
                        <ComboBoxItem Content="Niveau 2 (-k2)" Tag="2"/>
                        <ComboBoxItem Content="Niveau 3 (-k3)" Tag="3"/>
                        <ComboBoxItem Content="Niveau 4 (-k4)" Tag="4"/>
                        <ComboBoxItem Content="Niveau 5 (-k5)" Tag="5"/>
                        <ComboBoxItem Content="Niveau 6 (-k6, max. 2048K)" Tag="6"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Emu_MsxecRamHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,-6,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}" IsChecked="{Binding FullScreen}" Margin="0,0,16,0"/>
                <CheckBox Content="{DynamicResource Emu_CpcecIndicators}" IsChecked="{Binding ShowIndicators}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
