<UserControl x:Class="DemoBase.App.Views.Emulators.BrowserSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Browser" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Navigateur &amp; configuration" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Mode -->
            <TextBlock Text="Navigateur" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,6"
                      ItemsSource="{x:Static vm:BrowserSettingsViewModel.ModeOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Mode}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       Text="Mode 'personnalisé' : renseigner l'exécutable du navigateur dans le champ Executable de l'émulateur (chrome.exe, firefox.exe, msedge.exe…)."/>

            <!-- Allow file access -->
            <CheckBox IsChecked="{Binding AllowFileAccess}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="--allow-file-access-from-files"/>
                        <Run Text=" (Chrome/Edge — requis pour WebGL/WASM depuis un fichier local)"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,14"
                       TextWrapping="Wrap"
                       Text="Ignoré en mode 'navigateur par défaut'. Automatiquement désactivé pour les URLs en ligne."/>

            <!-- Astuce URL -->
            <Border Background="{DynamicResource BgSurface}"
                    CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Text="💡 Release en ligne (URL)" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="Pour une démo hébergée sur le web, saisissez l'URL complète (https://…) dans le champ Command Line du profil. DemoBase l'ouvrira directement dans le navigateur sans utiliser le fichier local."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
