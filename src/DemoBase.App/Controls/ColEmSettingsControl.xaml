<UserControl x:Class="DemoBase.App.Views.Emulators.ColEmSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}" Padding="18,14" Margin="0,0,0,20">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right" Text="ColEm v5.6" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="ColecoVision / Coleco Adam" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Video Standard -->
            <TextBlock Text="Standard vidéo" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding VideoStandard}" SelectedValuePath="Tag">
                <ComboBoxItem Content="NTSC (défaut)" Tag="ntsc"/>
                <ComboBoxItem Content="PAL"            Tag="pal"/>
            </ComboBox>

            <!-- SGM -->
            <CheckBox Content="Super Game Module (SGM) — homebrews récents"
                      IsChecked="{Binding SgmEnabled}" Margin="0,0,0,12"
                      Foreground="{DynamicResource TextPrimary}"/>

            <!-- BIOS info -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                           Text="BIOS requis : COLEM.ROM dans le dossier ColEm. Full screen : Alt+Enter pendant l'émulation."/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
