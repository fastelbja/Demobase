<UserControl x:Class="DemoBase.App.Views.Emulators.MameSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="MAME" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Arcade / multi-système" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Machine / driver -->
            <TextBlock Text="Machine / driver (obligatoire)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,6"
                      ItemsSource="{x:Static vm:MameSettingsViewModel.MachineSuggestions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding MachinePreset}"
                      SelectedValuePath="Value"
                      ToolTip="Choisir un système ici remplit automatiquement le driver ci-dessous"/>
            <TextBox Style="{StaticResource SearchBox}"
                     Text="{Binding Machine, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" FontFamily="Consolas" FontSize="12"
                     Margin="0,0,0,4"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="Choisissez un système dans la liste (le nom de driver est rempli automatiquement) ou saisissez-le. Liste complète des drivers : mame -listfull."/>

            <!-- Slot média -->
            <TextBlock Text="Média" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:MameSettingsViewModel.MediaOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding MediaSlot}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="« auto » déduit le slot de l'extension (image CD → -cdrm, disquette → -flop1)."/>

            <!-- BIOS (-rompath) -->
            <TextBlock Text="Dossier des BIOS système (-rompath)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                        Style="{StaticResource IconButton}"
                        Command="{Binding BrowseRomPathCommand}"
                        ToolTip="Parcourir…"/>
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding RomPath, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="Dossier contenant UNIQUEMENT les BIOS système (ex. neocdz.zip / neocd.zip pour Neo Geo CD, neogeo.zip pour l'arcade). Les jeux et releases sont fournis automatiquement par DemoBase — ne les placez pas ici. Laissez vide pour utiliser le rompath de mame.ini."/>

            <!-- Affichage / options -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,8"/>
            <CheckBox IsChecked="{Binding SkipInfo}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="-skip_gameinfo"/>
                        <Run Text=" — passe l'écran d'infos/avertissement au démarrage"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

        </StackPanel>
    </Border>
</UserControl>
