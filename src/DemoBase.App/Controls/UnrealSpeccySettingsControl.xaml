<UserControl x:Class="DemoBase.App.Views.Emulators.UnrealSpeccySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="UnrealSpeccy" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Machine &amp; configuration" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Machine HIMEM -->
            <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:UnrealSpeccySettingsViewModel.MachineOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Machine}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"
                       Text="La machine est injectée dans unreal.ini via -i avant le lancement."/>

            <!-- Statut du pack TSL (roms/boot.$b/wc.img) — visible uniquement en machine TSL,
                 téléchargé automatiquement depuis Mega dès la sélection de cette machine. -->
            <TextBlock FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"
                       Visibility="{Binding TslPackMessage, Converter={StaticResource NullToVisibility}}"
                       Text="{Binding TslPackMessage}"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}" IsChecked="{Binding FullScreen}" Margin="0,0,0,12"/>

            <TextBlock Text="Filtre vidéo" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}"
                      ItemsSource="{x:Static vm:UnrealSpeccySettingsViewModel.VideoFilterOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding VideoFilter}"
                      SelectedValuePath="Value"/>

        </StackPanel>
    </Border>
</UserControl>
