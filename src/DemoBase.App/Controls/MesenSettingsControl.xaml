<UserControl x:Class="DemoBase.App.Views.Emulators.MesenSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Mesen" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Multi-système (haute précision)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       Text="Mesen détecte automatiquement le système (SNES, NES, GB, GBA, PC Engine, Master System/Game Gear, WonderSwan) à partir de la ROM — aucun réglage supplémentaire n'est nécessaire."/>

            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}" IsChecked="{Binding FullScreen}"/>

        </StackPanel>
    </Border>
</UserControl>
