<UserControl x:Class="DemoBase.App.Views.Emulators.ProSystemSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="ProSystem" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Atari 7800 ProSystem" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Affichage — ajouté le 2026-07-24 : ProSystem n'a pas d'option CLI pour le
                 fullscreen/la résolution, ces réglages n'existent que dans ProSystem.ini
                 ([Display] Fullscreen/Mode.Width/Mode.Height) — patché automatiquement à
                 chaque lancement à partir de ces deux champs, cf. ProSystemLauncher. -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,10"/>

            <TextBlock Text="Résolution" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:ProSystemSettingsViewModel.ResolutionOptions}"
                      SelectedItem="{Binding SelectedResolution}"/>

            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="ℹ CLI minimale" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="ProSystem accepte le fichier ROM en argument et le charge automatiquement. Palette et autres options avancées se configurent directement dans l'interface de ProSystem (sauvegardées dans ProSystem.ini)."/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="BIOS : facultatif pour les demos/homebrew. Placer '7800.rom' dans le répertoire de ProSystem.exe pour l'écran d'accueil Atari et une compatibilité maximale sur les jeux commerciaux."/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Fullscreen/Résolution ci-dessus ne s'appliquent qu'à partir du 2ème lancement : ProSystem.exe doit d'abord créer lui-même son ProSystem.ini au tout premier démarrage."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
