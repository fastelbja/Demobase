<UserControl x:Class="DemoBase.App.Views.Emulators.Xm6TypeGSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="XM6 TypeG" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Sharp X68000" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Fullscreen -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox IsChecked="{Binding FullScreen}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Plein écran"/>
                        <Run Text=" — configuré via xm6g.ini (pas de paramètre CLI)"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

            <!-- ROMs requises -->
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,4">
                ROMs requises dans le dossier de XM6 TypeG :
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" Margin="8,0,0,12">
                • CGROM.dat — ROM CG (police caractères)&#x0a;• IPLROM.dat — ROM IPL (BIOS)&#x0a;• IPLROM30.dat / IPLROMXV.dat / IPLROMCO.dat (optionnel selon modèle)
            </TextBlock>

            <!-- Sauvegarde -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{DynamicResource Btn_Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="16,7"/>
                <TextBlock Text="{Binding SaveMessage}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
