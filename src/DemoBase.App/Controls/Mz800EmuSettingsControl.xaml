<UserControl x:Class="DemoBase.App.Views.Emulators.Mz800EmuSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="mz800emu" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Sharp MZ-700 / MZ-800 / MZ-1500" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Machine -->
            <TextBlock Text="Machine émulée" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:Mz800EmuSettingsViewModel.MachineOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding MachineType}"
                      SelectedValuePath="Value"/>

            <!-- Info -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Formats &amp; chargement" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="mz800emu v2.x ne supporte pas le chargement automatique de fichier via ini ou CLI. DemoBase lance le bon exe et extrait le ZIP si nécessaire. Chargez ensuite le fichier depuis l'émulateur : File > Open in CMT (.mzf .mzt .tap) ou File > Open in FDC (.dsk). Snapshots : .mzs (via quickload)."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
