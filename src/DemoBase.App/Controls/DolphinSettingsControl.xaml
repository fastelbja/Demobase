<UserControl x:Class="DemoBase.App.Views.Emulators.DolphinSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Dolphin" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Nintendo GameCube / Wii" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,8"/>

            <!-- Options frontend -->
            <TextBlock Text="Options frontend" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

            <CheckBox IsChecked="{Binding Batch}" Margin="0,0,0,6">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="-b (batch)"/>
                        <Run Text=" — quitte Dolphin automatiquement à l'arrêt du jeu"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>


            <!-- Sauvegarde -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource Btn_Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="16,7"/>
                <TextBlock Text="{Binding SaveMessage}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
