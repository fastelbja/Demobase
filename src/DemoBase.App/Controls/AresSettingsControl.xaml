<UserControl x:Class="DemoBase.App.Views.Emulators.AresSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="ares" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Multi-système (NES/SNES/GB/N64/MD…)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Système -->
            <TextBlock Text="Système (--system)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:AresSettingsViewModel.SystemOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding System}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="Requis quand l'extension est ambiguë (ex. .bin partagé entre Mega Drive et ColecoVision). Laissez vide pour l'auto-détection."/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,10"/>

            <!-- Options frontend -->
            <TextBlock Text="Options frontend" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

            <CheckBox IsChecked="{Binding NoFilePrompt}" Margin="0,0,0,6">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="--no-file-prompt"/>
                        <Run Text=" — pas de dialog pour ROMs secondaires (64DD, Super GameBoy…)"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

            <CheckBox IsChecked="{Binding Kiosk}" Margin="0,0,0,4">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="--kiosk"/>
                        <Run Text=" — UI minimale (implique --no-file-prompt)"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

        </StackPanel>
    </Border>
</UserControl>
