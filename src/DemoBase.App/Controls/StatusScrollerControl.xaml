<UserControl x:Class="DemoBase.App.Controls.StatusScrollerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28" ClipToBounds="True"
             Background="{DynamicResource BgSidebar}">
    <Grid>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
        <ctrl:ScrollerVisualHost x:Name="VisualHost"
             xmlns:ctrl="clr-namespace:DemoBase.App.Controls"/>
    </Grid>
</UserControl>
