<UserControl x:Class="DemoBase.App.Views.Emulators.Trs80gpSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="trs80gp" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="TRS-80 Model I/III/4" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Modèle -->
            <TextBlock Text="Modèle TRS-80" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="Model I" IsChecked="{Binding IsModel1}"  Margin="0,0,16,0"/>
                <RadioButton Content="Model III" IsChecked="{Binding IsModel3}" Margin="0,0,16,0"/>
                <RadioButton Content="Model 4" IsChecked="{Binding IsModel4}" />
            </StackPanel>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,12"/>

            <!-- Sauvegarde -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{DynamicResource Btn_Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="16,7"/>
                <TextBlock Text="{Binding SaveMessage}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
