<UserControl x:Class="DemoBase.App.Views.Emulators.GSplusSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="GSplus" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Apple IIgs" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Slot disque -->
            <TextBlock Text="Slot disque dans config.kegs" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:GSplusSettingsViewModel.SlotOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Slot}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"
                       TextWrapping="Wrap"
                       Text="DemoBase détecte automatiquement le slot selon l'extension. Forcer ici uniquement si nécessaire."/>

            <CheckBox IsChecked="{Binding Resizeable}" Margin="0,0,0,12">
                <CheckBox.Content>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="-resizeable"/>
                        <Run Text=" — fenêtre redimensionnable"
                             Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Fonctionnement" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,3"
                               Text="DemoBase extrait le ZIP et écrit le chemin dans config.kegs (répertoire de GSplus.exe) avant le lancement."/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,3"
                               Text="ROM requise : placer ROM.01 ou ROM.03 dans le répertoire de GSplus.exe."/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="Fullscreen : F11. Reset : Ctrl+F12. Config complète : F4."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
