<UserControl x:Class="DemoBase.App.Views.Emulators.FlycastSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Flycast" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Sega Dreamcast / Naomi / Atomiswave" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}" Margin="0,0,0,16"/>

            <!-- Région -->
            <TextBlock Text="Région" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="Default"  IsChecked="{Binding RegionDefault}" Margin="0,0,16,0"/>
                <RadioButton Content="Japan"    IsChecked="{Binding RegionJapan}"   Margin="0,0,16,0"/>
                <RadioButton Content="USA"      IsChecked="{Binding RegionUSA}"     Margin="0,0,16,0"/>
                <RadioButton Content="Europe"   IsChecked="{Binding RegionEurope}" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12">
                Un BIOS Dreamcast (dc_boot.bin) est optionnel mais recommandé — à placer dans le dossier de l'émulateur.
            </TextBlock>

            <!-- Sauvegarde -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{DynamicResource Btn_Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}"
                        Padding="16,7"/>
                <TextBlock Text="{Binding SaveMessage}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
