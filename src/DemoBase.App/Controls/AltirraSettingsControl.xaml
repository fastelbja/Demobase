<UserControl x:Class="DemoBase.App.Views.Emulators.AltirraSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DemoBase.App.Converters">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="Altirra" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_AltirraConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Modèle matériel -->
            <TextBlock Text="{DynamicResource Emu_Hardware}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding HardwareModel}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Atari 800 (48K, OS-B)"            Tag="800"/>
                <ComboBoxItem Content="Atari 800XL / 130XE (64K, OS rev. 2)" Tag="800xl"/>
                <ComboBoxItem Content="Atari 5200 (16K)"                 Tag="5200"/>
            </ComboBox>

            <!-- Standard vidéo + BASIC -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_VideoStandard}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding VideoStandard}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="PAL"  Tag="pal"/>
                        <ComboBoxItem Content="NTSC" Tag="ntsc"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="{DynamicResource Emu_BasicRom}"
                              IsChecked="{Binding BasicEnabled}"
                              Margin="0,0,0,6"/>
                </StackPanel>
            </Grid>

            <!-- Artifacting vidéo -->
            <TextBlock Text="{DynamicResource Emu_Artifacting}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,16"
                      SelectedValue="{Binding Artifacting}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Aucun"               Tag="none"/>
                <ComboBoxItem Content="NTSC"                Tag="ntsc"/>
                <ComboBoxItem Content="NTSC (haute qualité)" Tag="ntschi"/>
                <ComboBoxItem Content="PAL"                 Tag="pal"/>
                <ComboBoxItem Content="PAL (haute qualité)"  Tag="palhi"/>
            </ComboBox>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Content="{DynamicResource Emu_AltirraFullscreen}" IsChecked="{Binding FullScreen}" Margin="0,0,16,0"/>
                <CheckBox Content="{DynamicResource Emu_AltirraNoBorderless}" IsChecked="{Binding NoBorderless}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
