<UserControl x:Class="DemoBase.App.Views.Emulators.BlueMSXSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels.Emulators">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="blueMSX" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Machine MSX &amp; configuration" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Machine -->
            <TextBlock Text="{DynamicResource Emu_MachineType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,4"
                      ItemsSource="{x:Static vm:BlueMSXSettingsViewModel.MachineOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Machine}"
                      SelectedValuePath="Value"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Text="Le nom doit correspondre à un dossier dans Machines/ de blueMSX. Les machines C-BIOS ne nécessitent pas de ROMs propriétaires."/>

            <!-- Fréquence -->
            <TextBlock Text="Fréquence" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      ItemsSource="{x:Static vm:BlueMSXSettingsViewModel.FreqOptions}"
                      DisplayMemberPath="Key"
                      SelectedValue="{Binding Freq}"
                      SelectedValuePath="Value"/>

            <!-- Affichage -->
            <CheckBox Content="{DynamicResource Emu_CpcecFullscreen}"
                      IsChecked="{Binding FullScreen}"/>

        </StackPanel>
    </Border>
</UserControl>
