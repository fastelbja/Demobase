<UserControl x:Class="DemoBase.App.Views.Emulators.DosBoxXSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="DOSBox-X" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_DosBoxXConfig}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Carte graphique / machine -->
            <TextBlock Text="{DynamicResource Emu_GraphicsCard}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding Machine}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="CGA"                    Tag="cga"/>
                <ComboBoxItem Content="EGA"                    Tag="ega"/>
                <ComboBoxItem Content="Tandy"                  Tag="tandy"/>
                <ComboBoxItem Content="PCjr"                   Tag="pcjr"/>
                <ComboBoxItem Content="Hercules (monochrome)"  Tag="hercules"/>
                <ComboBoxItem Content="VGA"                    Tag="vgaonly"/>
                <ComboBoxItem Content="SVGA S3 (par défaut)"   Tag="svga_s3"/>
            </ComboBox>

            <!-- CPU + Mémoire -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_CPU}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding CpuType}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Auto (défaut)"           Tag="auto"/>
                        <ComboBoxItem Content="8086"                    Tag="8086"/>
                        <ComboBoxItem Content="8086 with prefetch"      Tag="8086_prefetch"/>
                        <ComboBoxItem Content="80186"                   Tag="80186"/>
                        <ComboBoxItem Content="80186 with prefetch"     Tag="80186_prefetch"/>
                        <ComboBoxItem Content="286"                     Tag="286"/>
                        <ComboBoxItem Content="286 with prefetch"       Tag="286_prefetch"/>
                        <ComboBoxItem Content="386"                     Tag="386"/>
                        <ComboBoxItem Content="386 with prefetch"       Tag="386_prefetch"/>
                        <ComboBoxItem Content="486 (old)"               Tag="486_old"/>
                        <ComboBoxItem Content="486 (old) with prefetch" Tag="486_old_prefetch"/>
                        <ComboBoxItem Content="486"                     Tag="486"/>
                        <ComboBoxItem Content="486 with prefetch"       Tag="486_prefetch"/>
                        <ComboBoxItem Content="Pentium"                 Tag="pentium"/>
                        <ComboBoxItem Content="Pentium MMX"             Tag="pentium_mmx"/>
                        <ComboBoxItem Content="Pentium Pro"             Tag="ppro_slow"/>
                        <ComboBoxItem Content="Pentium II"              Tag="p2"/>
                        <ComboBoxItem Content="Pentium III"             Tag="p3"/>
                        <ComboBoxItem Content="Experimental"            Tag="experimental"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Emu_Memory}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding MemSize}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="1 Mo"            Tag="1"/>
                        <ComboBoxItem Content="4 Mo"            Tag="4"/>
                        <ComboBoxItem Content="16 Mo (défaut)"  Tag="16"/>
                        <ComboBoxItem Content="32 Mo"           Tag="32"/>
                        <ComboBoxItem Content="64 Mo"           Tag="64"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Cycles -->
            <TextBlock Text="{DynamicResource Emu_Cycles}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <!-- Cycles : ComboBox de présets + TextBox saisie libre -->
            <ComboBox x:Name="CyclesPresets"
                      Style="{StaticResource FlatComboBox}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding Cycles}"
                      Margin="0,0,0,4">
                <ComboBoxItem Tag="auto"    Content="auto"/>
                <ComboBoxItem Tag="max"     Content="max"/>
                <ComboBoxItem Tag="fixed 240"    Content="fixed 240    — 8088 XT 4.77MHz"/>
                <ComboBoxItem Tag="fixed 750"    Content="fixed 750    — 286 8MHz"/>
                <ComboBoxItem Tag="fixed 1510"   Content="fixed 1510   — 286 12MHz"/>
                <ComboBoxItem Tag="fixed 3300"   Content="fixed 3300   — 286 25MHz"/>
                <ComboBoxItem Tag="fixed 4595"   Content="fixed 4595   — 386DX 25MHz"/>
                <ComboBoxItem Tag="fixed 6075"   Content="fixed 6075   — 386DX 33MHz"/>
                <ComboBoxItem Tag="fixed 12010"  Content="fixed 12010  — 486DX 33MHz"/>
                <ComboBoxItem Tag="fixed 23880"  Content="fixed 23880  — 486DX2 66MHz"/>
                <ComboBoxItem Tag="fixed 33445"  Content="fixed 33445  — 486DX4 100MHz"/>
                <ComboBoxItem Tag="fixed 47810"  Content="fixed 47810  — 486DX5 133MHz"/>
                <ComboBoxItem Tag="fixed 32090"  Content="fixed 32090  — Pentium 60MHz"/>
                <ComboBoxItem Tag="fixed 35620"  Content="fixed 35620  — Pentium 66MHz"/>
                <ComboBoxItem Tag="fixed 48087"  Content="fixed 48087  — Pentium 90MHz"/>
                <ComboBoxItem Tag="fixed 53430"  Content="fixed 53430  — Pentium 100MHz"/>
                <ComboBoxItem Tag="fixed 64180"  Content="fixed 64180  — Pentium 120MHz"/>
                <ComboBoxItem Tag="fixed 71240"  Content="fixed 71240  — Pentium 133MHz"/>
                <ComboBoxItem Tag="fixed 95548"  Content="fixed 95548  — Pentium 166MHz MMX"/>
                <ComboBoxItem Tag="fixed 114657" Content="fixed 114657 — Pentium 200MHz MMX"/>
                <ComboBoxItem Tag="fixed 130000" Content="fixed 130000 — AMD K6 200MHz"/>
                <ComboBoxItem Tag="fixed 193000" Content="fixed 193000 — AMD K6-2 300MHz"/>
                <ComboBoxItem Tag="fixed 306000" Content="fixed 306000 — AMD Athlon 600MHz"/>
                <ComboBoxItem Tag="fixed 407000" Content="fixed 407000 — Pentium III 866MHz EB"/>
            </ComboBox>
            <!-- Saisie libre pour valeurs personnalisées (ex: "fixed 8000", "max 90") -->
            <TextBox Text="{Binding Cycles, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchBox}" Padding="8,6" Margin="0,4,0,4"
                     FontFamily="Consolas" FontSize="12"
                     ToolTip="Saisie libre : auto / max / fixed N / max N%"/>
            <TextBlock Text="{DynamicResource Emu_CyclesHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Son -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Emu_SoundBlaster}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding SbType}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Aucune" Tag="none"/>
                        <ComboBoxItem Content="Sound Blaster 1.0"  Tag="sb1"/>
                        <ComboBoxItem Content="Sound Blaster Pro 2" Tag="sbpro2"/>
                        <ComboBoxItem Content="Sound Blaster 16 (défaut)" Tag="sb16"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="{DynamicResource Emu_Gus}" IsChecked="{Binding Gus}" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,8,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox Content="{DynamicResource Emu_DosBoxXFullscreen}" IsChecked="{Binding FullScreen}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
