<UserControl x:Class="DemoBase.App.Views.Emulators.CxbxReloadedSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="CXBX-Reloaded" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Xbox original (OG Xbox)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Lancement" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Text="Commande : cxbxr-ldr.exe /load &quot;default.xbe&quot;"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Les jeux Xbox sont des dossiers contenant un default.xbe. Passer le fichier .xbe directement. CXBX-Reloaded se relance lui-même pour l'émulation — à la fin, le processus se termine automatiquement (pas de retour à l'UI)."/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Fullscreen : pas d'option CLI — configurer dans Settings › Config Video de l'interface CXBX-Reloaded. Pas de BIOS requis."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
