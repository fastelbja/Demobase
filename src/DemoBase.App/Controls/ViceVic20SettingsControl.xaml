<UserControl x:Class="DemoBase.App.Views.Emulators.ViceVic20SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="18,14" Margin="0,0,0,20">
        <StackPanel>

            <!-- Titre -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right"
                           Text="VICE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Emu_ViceVic20Config}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <!-- Région -->
            <TextBlock Text="{DynamicResource Emu_VideoStandard}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding Region}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="PAL (défaut)" Tag="pal"/>
                <ComboBoxItem Content="NTSC"         Tag="ntsc"/>
            </ComboBox>

            <!-- Mémoire -->
            <TextBlock Text="{DynamicResource Emu_Memory}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox Style="{StaticResource FlatComboBox}" Margin="0,0,0,12"
                      SelectedValue="{Binding Memory}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Aucune (5 Kio, défaut)"     Tag=""/>
                <ComboBoxItem Content="+3 Kio (8 Kio au total)"    Tag="0"/>
                <ComboBoxItem Content="+8 Kio (13 Kio au total)"   Tag="1"/>
                <ComboBoxItem Content="+16 Kio (21 Kio au total)"  Tag="1,2"/>
                <ComboBoxItem Content="+24 Kio (29 Kio au total)"  Tag="1,2,3"/>
                <ComboBoxItem Content="Toute la mémoire (35 Kio)"  Tag="0,1,2,3,5"/>
            </ComboBox>

            <!-- Lecteur -->
            <CheckBox Content="{DynamicResource Emu_TrueDrive}" IsChecked="{Binding TrueDrive}" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Emu_TrueDriveHint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Affichage -->
            <TextBlock Text="{DynamicResource Emu_Display}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Emu_VicFullscreen}" IsChecked="{Binding FullScreen}"/>

        </StackPanel>
    </Border>
</UserControl>
