<Window x:Class="DemoBase.App.ScreenshotDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DemoBase.App.Converters"
        Title="Téléchargement des screenshots"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BgApp}">

    <DockPanel Margin="24">

        <!-- Titre + chemin -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource SS_Title}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding ImagesRootDisplay}"
                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Note légale -->
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,16,0,0" FontSize="10"
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                   Text="{DynamicResource SS_Info}"/>

        <!-- Boutons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Content="{DynamicResource App_OpenFolder}"
                    Command="{Binding OpenFolderCommand}"
                    Padding="12,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}"
                        Content="{DynamicResource List_Start}"
                        Command="{Binding StartCommand}"
                        Padding="18,8" FontSize="13" Margin="0,0,10,0"/>
                <Button Style="{StaticResource IconButton}"
                        Content="{DynamicResource List_Stop}"
                        Command="{Binding CancelCommand}"
                        Padding="14,8"
                        Foreground="{DynamicResource Red}"
                        Visibility="{Binding IsRunning,
                            Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Corps -->
        <StackPanel>

            <!-- Stats -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Total}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SS_Total}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Skipped}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Green}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SS_AlreadyLocal}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Errors}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource Red}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SS_Errors}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Message statut -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" Margin="0,0,0,12" MinHeight="36"/>

            <!-- Barre de progression -->
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="4" Height="10" Margin="0,0,0,4">
                <ProgressBar Value="{Binding ProgressPercent}"
                             Minimum="0" Maximum="100"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource Accent}"/>
            </Border>
            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:N1}%}"
                       FontSize="11" Foreground="{DynamicResource TextAccent}"
                       HorizontalAlignment="Right"/>

        </StackPanel>
    </DockPanel>
</Window>
