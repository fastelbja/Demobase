<Window x:Class="DemoBase.App.ImportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ImportProg_Subtitle}"
        Width="520" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12" Background="#1A1A1F"
            BorderBrush="#2E2E3A" BorderThickness="1">
        <DockPanel>

            <!-- Barre de titre custom -->
            <Border DockPanel.Dock="Top" Background="#16161A"
                    CornerRadius="12,12,0,0" Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                            Background="Transparent" Foreground="#9090A8"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnClose_Click" FontSize="12"/>
                    <StackPanel>
                        <TextBlock Text="DemoBase" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#E8E8F0" FontFamily="Segoe UI"/>
                        <TextBlock Text="{DynamicResource ImportProg_Subtitle}" FontSize="11"
                                   Foreground="#5A5A70" Margin="0,1,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Corps -->
            <StackPanel Margin="28,20,28,24" VerticalAlignment="Center">

                <!-- Icône + phase -->
                <DockPanel Margin="0,0,0,16">
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="#26262E" Margin="0,0,14,0">
                        <TextBlock x:Name="PhaseIcon" Text="⬇" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#5B9BD5"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPhase" Text="{DynamicResource ImportProg_Preparing}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E8E8F0" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtMessage" Text=""
                                   FontSize="11" Foreground="#9090A8"
                                   FontFamily="Segoe UI" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <!-- Barre de progression déterminée (téléchargement) -->
                <Border x:Name="DeterminateBorder"
                        Background="#26262E" CornerRadius="4" Height="8" Margin="0,0,0,8">
                    <Grid>
                        <Border x:Name="ProgressFill" Background="#5B9BD5"
                                CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </Border>

                <!-- ProgressBar WPF native en mode indéterminé (parsing) -->
                <!-- Gère son propre threading — pas de Storyboard manuel -->
                <ProgressBar x:Name="IndeterminateBar"
                             Height="6" Margin="0,0,0,10"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="#5B9BD5"
                             Background="#26262E"
                             BorderThickness="0"/>

                <!-- Stats + pourcentage -->
                <DockPanel>
                    <TextBlock x:Name="TxtStats" Text=""
                               Foreground="#5A5A70" FontSize="11" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtPercent" DockPanel.Dock="Right"
                               Text="" Foreground="#5B9BD5"
                               FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Right" FontFamily="Segoe UI"/>
                </DockPanel>

                <!-- Note légale -->
                <TextBlock Margin="0,16,0,0"
                           Text="{DynamicResource ImportProg_Legal}"
                           FontSize="10" Foreground="#3A3A50"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
