<Window x:Class="DemoBase.App.DemozooRawExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Demozoo Raw DB" Height="200" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="{DynamicResource BgApp}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="8">
        <StackPanel Margin="32,24">
            <TextBlock Text="{DynamicResource Export_Title}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Export_Download}"
                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <ProgressBar x:Name="ExportProgress" Height="4" BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"
                         Margin="0,0,0,10" Minimum="0" Maximum="100"/>

            <TextBlock x:Name="MessageText" FontSize="11" FontFamily="Courier New"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>

            <TextBlock x:Name="StatsText" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
