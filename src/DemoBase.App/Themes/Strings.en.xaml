    <!-- ── "How to quit the emulator" info popups (TR-DOS, blueMSX, WinUAE, Hatari) ── -->
    <sys:String x:Key="Dlg_DontShowAgain">Don't show this message again</sys:String>
    <sys:String x:Key="Dlg_Understood">Got it</sys:String>

    <sys:String x:Key="Dlg_TrDos_Title">TR-DOS disk</sys:String>
    <sys:String x:Key="Dlg_TrDos_Heading">💾 This game is on a TR-DOS disk</sys:String>
    <sys:String x:Key="Dlg_TrDos_Body">ZEsarUX mounts the disk but doesn't load it automatically — just like on a real Spectrum, you need to type two commands yourself once the emulator is open:</sys:String>
    <sys:String x:Key="Dlg_TrDos_Cmd1">RANDOMIZE USR 15616</sys:String>
    <sys:String x:Key="Dlg_TrDos_Cmd1Desc">then [ENTER] — opens TR-DOS and shows the catalog (the list of files on the disk).</sys:String>
    <sys:String x:Key="Dlg_TrDos_Cmd2">RUN "NAME"</sys:String>
    <sys:String x:Key="Dlg_TrDos_Cmd2Desc">then [ENTER] — replace NAME with the exact name shown in the catalog, to load and run the program.</sys:String>

    <sys:String x:Key="Dlg_BlueMSX_Title">blueMSX</sys:String>
    <sys:String x:Key="Dlg_BlueMSX_Heading">⌨ How to quit blueMSX</sys:String>
    <sys:String x:Key="Dlg_BlueMSX_Body">blueMSX has no "Close" button or classic Alt+F4 shortcut — you need to use its own key combination:</sys:String>
    <sys:String x:Key="Dlg_BlueMSX_Shortcut">Left Ctrl + Pause</sys:String>
    <sys:String x:Key="Dlg_BlueMSX_ShortcutDesc">immediately closes the emulator — this is blueMSX's official "Exit" shortcut.</sys:String>

    <sys:String x:Key="Dlg_WinUAE_Title">WinUAE</sys:String>
    <sys:String x:Key="Dlg_WinUAE_Heading">⌨ How to quit WinUAE</sys:String>
    <sys:String x:Key="Dlg_WinUAE_Body">WinUAE has no "Close" button or classic Alt+F4 shortcut in full screen — you need to use its own key combination:</sys:String>
    <sys:String x:Key="Dlg_WinUAE_Shortcut">Ctrl + F11</sys:String>
    <sys:String x:Key="Dlg_WinUAE_ShortcutDesc">closes the emulator.</sys:String>

    <sys:String x:Key="Dlg_Hatari_Title">Hatari</sys:String>
    <sys:String x:Key="Dlg_Hatari_Heading">⌨ How to quit Hatari</sys:String>
    <sys:String x:Key="Dlg_Hatari_Body">Hatari has no "Close" button or classic Alt+F4 shortcut — you need to use its own key combination:</sys:String>
    <sys:String x:Key="Dlg_Hatari_Shortcut">AltGr + Q</sys:String>
    <sys:String x:Key="Dlg_Hatari_ShortcutDesc">closes the emulator (AltGr = right Alt key). Alternatively, F12 opens the Hatari menu, which also has a "Quit" button.</sys:String>

    <sys:String x:Key="Dlg_DosBoxX_Title">DOSBox-X</sys:String>
    <sys:String x:Key="Dlg_DosBoxX_Heading">⌨ How to quit DOSBox-X</sys:String>
    <sys:String x:Key="Dlg_DosBoxX_Body">Closing the window (X button or Alt+F4) while a demo is running brings up a DOSBox-X confirmation prompt. To skip it:</sys:String>
    <sys:String x:Key="Dlg_DosBoxX_Shortcut">Ctrl + F9</sys:String>
    <sys:String x:Key="Dlg_DosBoxX_ShortcutDesc">quits immediately, no confirmation. Otherwise, DOSBox-X closes on its own once the demo ends by itself.</sys:String>

