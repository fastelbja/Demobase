<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ───────────────────────────────────────────────────── -->
    <Color x:Key="BgAppColor">#1A1A1F</Color>
    <Color x:Key="BgSidebarColor">#16161A</Color>
    <Color x:Key="BgPanelColor">#1E1E24</Color>
    <Color x:Key="BgCardColor">#26262E</Color>
    <Color x:Key="BgHoverColor">#2E2E38</Color>
    <Color x:Key="BgSelectedColor">#1E4A78</Color>
    <Color x:Key="BgInputColor">#2A2A34</Color>

    <!-- ── Text ───────────────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#E8E8F0</Color>
    <Color x:Key="TextSecondaryColor">#9090A8</Color>
    <Color x:Key="TextMutedColor">#5A5A70</Color>
    <Color x:Key="TextAccentColor">#5B9BD5</Color>
    <Color x:Key="TextLinkColor">#6BAED6</Color>

    <!-- ── Borders ────────────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#2E2E3A</Color>
    <Color x:Key="BorderFocusColor">#5B9BD5</Color>

    <!-- ── Semantic ──────────────────────────────────────────────────────── -->
    <Color x:Key="AccentColor">#5B9BD5</Color>
    <Color x:Key="AccentHoverColor">#7AB3E0</Color>
    <Color x:Key="GoldColor">#E8A020</Color>
    <Color x:Key="GreenColor">#4CAF80</Color>
    <Color x:Key="RedColor">#E05050</Color>

    <!-- ── Brushes ───────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BgApp"      Color="{StaticResource BgAppColor}"/>
    <SolidColorBrush x:Key="BgSidebar"  Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgPanel"    Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgCard"     Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgHover"    Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgSelected" Color="{StaticResource BgSelectedColor}"/>
    <SolidColorBrush x:Key="BgInput"    Color="{StaticResource BgInputColor}"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextAccent"    Color="{StaticResource TextAccentColor}"/>
    <SolidColorBrush x:Key="TextLink"      Color="{StaticResource TextLinkColor}"/>

    <SolidColorBrush x:Key="Border"      Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderFocus" Color="{StaticResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="Accent"      Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSubtle" Color="{StaticResource AccentColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="Gold"        Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="Green"       Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="Red"         Color="{StaticResource RedColor}"/>
    <!-- Fond rouge subtil (2026-07-24) — plateformes non émulées dans PlatformListView,
         même principe/opacité que AccentSubtle ci-dessus. -->
    <SolidColorBrush x:Key="BgDanger"    Color="{StaticResource RedColor}" Opacity="0.15"/>

</ResourceDictionary>
