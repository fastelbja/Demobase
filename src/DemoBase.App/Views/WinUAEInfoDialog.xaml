<Window x:Class="DemoBase.App.Views.WinUAEInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dlg_WinUAE_Title}"
        Width="480" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgApp}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DemoBase.App;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource Dlg_WinUAE_Heading}"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

        <TextBlock Text="{DynamicResource Dlg_WinUAE_Body}"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>

        <Border Background="{DynamicResource BgSurface}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}" Margin="0,0,0,4"
                           Text="{DynamicResource Dlg_WinUAE_Shortcut}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{DynamicResource Dlg_WinUAE_ShortcutDesc}"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="DontShowAgainCheck" Content="{DynamicResource Dlg_DontShowAgain}"
                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                   Margin="0,0,0,18"/>

        <Button Content="{DynamicResource Dlg_Understood}" Click="Ok_Click"
                HorizontalAlignment="Right"
                Padding="24,8" FontSize="12"
                Style="{StaticResource AccentButton}"
                IsDefault="True"/>
    </StackPanel>
</Window>
