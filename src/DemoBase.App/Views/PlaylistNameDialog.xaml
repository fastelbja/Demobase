<Window x:Class="DemoBase.App.Views.PlaylistNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgApp}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DemoBase.App;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <!-- Label -->
        <TextBlock x:Name="LabelText" Text="Nom de la playlist :"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,8"/>

        <!-- Champ texte -->
        <TextBox x:Name="NameBox"
                 FontSize="13" Padding="8"
                 Background="{DynamicResource BgHover}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1"
                 Margin="0,0,0,16"
                 KeyDown="NameBox_KeyDown"/>

        <!-- Boutons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Annuler"
                    Padding="16,8" Margin="0,0,8,0"
                    Style="{StaticResource IconButton}"
                    Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="✓ Valider"
                    Padding="16,8"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
