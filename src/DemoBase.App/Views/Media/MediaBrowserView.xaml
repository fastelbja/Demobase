<UserControl x:Class="DemoBase.App.Views.Media.MediaBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:media="clr-namespace:DemoBase.App.Views.Media"
             Background="{DynamicResource BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Tabs -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Tab bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">

                <!-- Compteur + titre à droite -->
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock x:Name="CounterText" FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Tabs — Music en premier -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ShowMusicCommand}"
                            Padding="0,14" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♪  " FontSize="13"/>
                            <TextBlock Text="Music" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <!-- 2026-07-30 : actif seulement si NI Graphics NI Modland ne
                                                 le sont — cf. 3e onglet Modland ajouté ci-dessous. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsGraphicsActive}" Value="False"/>
                                                    <Condition Binding="{Binding IsModlandActive}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ShowGraphicsCommand}"
                            Padding="0,14" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼  " FontSize="13"/>
                            <TextBlock Text="Graphics" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGraphicsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!-- 2026-07-30, demande utilisateur : onglet "Musique (modland)" pour
                         parcourir/écouter le catalogue http://ftp.modland.com/. -->
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ShowModlandCommand}"
                            Padding="0,14" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵  " FontSize="13"/>
                            <TextBlock Text="{DynamicResource Modland_TabTitle}" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModlandActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Graphics view ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsGraphicsActive, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Graphics -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="24,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Text="{DynamicResource MB_GraphicsCollection}" Margin="0,0,0,4"/>
                    <TextBlock FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}">
                        <Run Text="{Binding Graphics.TotalCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource MB_GraphicsCount}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Barre de filtres Graphics -->
            <Border Grid.Row="1" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="16,8">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Right"
                              ItemsSource="{Binding Graphics.SortOptions}"
                              SelectedItem="{Binding Graphics.SortBy}"
                              Style="{StaticResource FlatComboBox}"
                              Width="90" Margin="0,0,4,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{DynamicResource MB_SortBy}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Graphics.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             Tag="search" Padding="8,5"
                             VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Grille de vignettes -->
            <ScrollViewer Grid.Row="2" x:Name="GfxScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="GfxScroller_ScrollChanged">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Foreground="{DynamicResource Accent}"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding Graphics.IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                    <ItemsControl x:Name="GfxGrid"
                                  ItemsSource="{Binding Graphics.Items}"
                                  Margin="16,16,16,80">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBd"
                                        Width="180" Height="180"
                                        Margin="6"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        Background="{DynamicResource BgCard}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.Graphics.OpenReleaseCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.Graphics.StartSlideshowCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Image Source="{Binding ThumbPath, Converter={StaticResource ThumbnailPath}, ConverterParameter=180}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <Border Background="{DynamicResource BgHover}"
                                                Visibility="{Binding ThumbPath, Converter={StaticResource InverseNullToVisibility}}">
                                            <!-- 2026-07-30, téléchargement progressif : "⬇" pendant que le ZIP
                                                 manquant est récupéré en arrière-plan, sinon "🖼" par défaut. -->
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🖼"/>
                                                        <Setter Property="FontSize" Value="40"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Text" Value="⬇"/>
                                                                <Setter Property="FontSize" Value="28"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Border x:Name="HoverOverlay"
                                                Background="#CC000000"
                                                Opacity="0" VerticalAlignment="Bottom"
                                                Padding="10,24,10,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Release.Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Release.AuthorNames}"
                                                           FontSize="10" Foreground="#CCFFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="PlayBtn"
                                                Width="44" Height="44"
                                                CornerRadius="22"
                                                Background="{DynamicResource Accent}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0">
                                            <TextBlock Text="▶" FontSize="16"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="3,0,0,0"/>
                                        </Border>
                                    </Grid>

                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="PlayBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="PlayBtn"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Music view ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <!-- 2026-07-30 : visible seulement si NI Graphics NI Modland (3e onglet)
                             ne sont actifs — un simple InverseBoolToVisibility sur IsGraphicsActive
                             ne suffit plus depuis l'ajout de Modland. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGraphicsActive}" Value="False"/>
                                <Condition Binding="{Binding IsModlandActive}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header hero -->
                <RowDefinition Height="Auto"/>  <!-- Filtre / recherche -->
                <RowDefinition Height="*"/>     <!-- Track list -->
            </Grid.RowDefinitions>

            <!-- Hero header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="24,20">
                <DockPanel>
                    <!-- Boutons à droite -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="⏮"
                                Style="{StaticResource IconButton}"
                                Command="{Binding Music.PlayPreviousCommand}"
                                ToolTip="Release précédente"
                                Padding="10,8" Margin="0,0,4,0"/>
                        <Button Content="⏹"
                                Style="{StaticResource IconButton}"
                                Command="{Binding Music.StopCommand}"
                                ToolTip="Arrêter la lecture"
                                Padding="10,8" Margin="0,0,4,0"/>
                        <Button Content="⏭"
                                Style="{StaticResource IconButton}"
                                Command="{Binding Music.PlayNextCommand}"
                                ToolTip="Release suivante"
                                Padding="10,8" Margin="0,0,10,0"/>
                        <ToggleButton Content="{DynamicResource MB_Shuffle}"
                                      Style="{StaticResource FilterChip}"
                                      IsChecked="{Binding Music.IsShuffleMode, Mode=OneWay}"
                                      Command="{Binding Music.ToggleShuffleCommand}"
                                      Padding="14,8"
                                      ToolTip="Shuffle On/Off — pioche aléatoirement parmi 130 000+ musiques"/>
                    </StackPanel>

                    <!-- Info gauche -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"
                                   Text="{DynamicResource MB_MusicCollection}"
                                   Margin="0,0,0,4"/>
                        <TextBlock FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}">
                            <Run Text="{Binding Music.TotalCount, Mode=OneWay}"/>
                            <Run Text="{DynamicResource MB_MusicReleases}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"
                                   Text="{DynamicResource MB_ClickToListen}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barre de filtres Music -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="16,8">
                <StackPanel>
                    <!-- Bascule Auteur/Titre — remplace l'ancien tri (ComboBox), qui
                         ne fonctionnait pas correctement. Détermine sur quel champ
                         porte la recherche saisie juste en dessous. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="{DynamicResource MB_SearchByAuthor}"
                                     GroupName="MusicSearchField"
                                     Margin="0,0,16,0"
                                     IsChecked="{Binding Music.SearchField,
                                         Converter={StaticResource EqualityConverter},
                                         ConverterParameter=Author}"/>
                        <RadioButton Content="{DynamicResource MB_SearchByTitle}"
                                     GroupName="MusicSearchField"
                                     IsChecked="{Binding Music.SearchField,
                                         Converter={StaticResource EqualityConverter},
                                         ConverterParameter=Title}"/>
                    </StackPanel>
                    <TextBox Text="{Binding Music.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             Tag="search"
                             Padding="8,5"/>
                </StackPanel>
            </Border>

            <!-- Track list -->
            <ScrollViewer Grid.Row="2" x:Name="MusicScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="MusicScroller_ScrollChanged">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="2"
                                 Foreground="{DynamicResource Accent}"
                                 Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding Music.IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- En-tête colonnes -->
                    <Grid Margin="16,8,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="TITRE / AUTEUR" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="PLATEFORMES" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="3" Text="ANNÉE" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="16,6"/>

                    <!-- Items -->
                    <ItemsControl x:Name="MusicItemsControl" ItemsSource="{Binding Music.Items}" Margin="8,0,8,80">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TrackBd"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="8,6" Margin="0,1"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.Music.PlayReleaseCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge format fichier -->
                                        <Border Grid.Column="0"
                                                Width="36" Height="22"
                                                CornerRadius="3"
                                                Background="{Binding MainFileExt, Converter={StaticResource FileExtToColor}}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding MainFileExt, Converter={StaticResource FileExtToLabel}}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Titre + auteur -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Margin="12,0,8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AuthorNames}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Plateformes -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlatformNames}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Année -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ReleaseYear}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Hover + highlight lecture en cours -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource BgHover}"/>
                                                </Trigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource IntEquality}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.Music.SelectedItem.Id"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Modland view ──────────────────────────────────────────────────── -->
        <!-- 2026-07-30, demande utilisateur : onglet "Musique (modland)" — DataContext
             dédié (Modland, propriété de MediaBrowserViewModel) plutôt que de tout
             reproduire directement dans ce fichier déjà volumineux.
             2026-07-30 (correctif) : Visibility ET DataContext ne doivent PAS être sur
             le MÊME élément — une fois DataContext="{Binding Modland}" appliqué, TOUT
             binding porté par CE MÊME élément (donc aussi Visibility) se met à chercher
             IsModlandActive sur ModlandBrowserViewModel au lieu de MediaBrowserViewModel
             ("BindingExpression path error : 'IsModlandActive' property not found on
             ...ModlandBrowserViewModel"). Un conteneur englobant porte Visibility (résolu
             contre le DataContext hérité normal), le DataContext dédié ne s'applique
             qu'à l'intérieur, sur ModlandBrowserView lui-même. -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsModlandActive, Converter={StaticResource BoolToVisibility}}">
            <media:ModlandBrowserView DataContext="{Binding Modland}"/>
        </Grid>
    </Grid>
</UserControl>
