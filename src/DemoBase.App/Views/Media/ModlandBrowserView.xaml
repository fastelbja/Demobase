<UserControl x:Class="DemoBase.App.Views.Media.ModlandBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:data="clr-namespace:DemoBase.Data;assembly=DemoBase.Data"
             Background="{DynamicResource BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header : statut sync + Rafraîchir + toggle mode -->
            <!-- 2026-08-01, demande utilisateur : "je m'aperçois que je ne peux pas
                 faire de recherche sur le nom du fichier dans le browser modland.
                 peux tu rajouter une zone de saisie de recherche en dessous de
                 'Musiques' qui prenne la largeur jusqu'à 'Pistes' incluse ?" -->
            <RowDefinition Height="Auto"/>  <!-- Recherche par nom de fichier -->
            <RowDefinition Height="*"/>     <!-- Formats | Auteurs | Pistes | Player -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="20,12"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource BgCard}">
            <DockPanel>

                <!-- Rafraîchir + statut de sync -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="100" Height="4" Margin="0,0,10,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding SyncPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource Accent}"
                                 Background="{DynamicResource BgHover}"
                                 BorderThickness="0"
                                 Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding SyncMessage}" FontSize="10" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"
                               Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{DynamicResource Modland_Refresh}"
                            Style="{StaticResource IconButton}" FontSize="11" Padding="10,6"
                            Command="{Binding SyncCommand}"
                            IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBool}}"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Modland_Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding SyncStatusMessage}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Recherche par nom de fichier ───────────────────────────────────
             2026-08-01, retour utilisateur ("ça deborde un peu. fait le arriver
             jusqu'au bord droit du trait gris en dessous") : le 1er jet avait un
             Margin horizontal (14) sur ce Grid alors que la grille de contenu
             ci-dessous n'en a AUCUN sur son propre Grid (seules ses colonnes internes
             ont un Margin="14,12" chacune) — ce décalage de 14px désynchronisait les
             deux grilles. Corrigé : AUCUN margin horizontal ici non plus, mêmes
             largeurs de colonnes EXACTES que la grille de contenu (les 7, pas
             seulement les 5 premières) — la TextBox va maintenant jusqu'au bord droit
             du séparateur gris (Grid.ColumnSpan="6", colonnes 0 à 5 incluse), comme
             demandé, et la colonne 6 (Player) sert à afficher le chemin de la piste en
             cours de lecture, à droite de la zone de recherche. -->
        <Grid Grid.Row="1" Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="300" MinWidth="260"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Grid.ColumnSpan="6" Margin="14,0,0,0" Padding="8,6"
                     Text="{Binding FileNameSearch, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- 2026-08-01, retour utilisateur ("à droite de cette zone de saisie,
                 peux tu mettre le chemin complet du fichier en cours de lecture ?
                 (sans le /pub/modules/...)") : CurrentTrackPath = Format/Auteur/
                 NomFichier (ModlandTrackRow.RelativePath), déjà sans le préfixe
                 /pub/modules/ (jamais présent dans cette valeur — reconstruit à
                 partir des seules colonnes Format/Author/FileName du catalogue).
                 2026-08-01, retour utilisateur ("peux tu changer la police et la
                 couleur du chemin ? idem que celles utilisées pour afficher
                 'Musique (modland)' ?") : mêmes FontSize/FontWeight/Foreground que
                 le TextBlock "Modland_Title" du header (ligne ~45) — police par
                 défaut de l'appli (retrait de FontFamily="Consolas") plutôt que
                 monospace, TextPrimary plutôt que TextMuted. -->
            <TextBlock Grid.Column="6" Margin="10,0,14,0"
                       Text="{Binding CurrentTrackPath}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Visibility="{Binding CurrentTrackPath, Converter={StaticResource NullToVisibility}}"/>
        </Grid>

        <!-- ── Contenu ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="1"/>
                <!-- 2026-07-30, retour utilisateur : "peux tu raccourcir la colonne
                     nom ? pas besoin d'utiliser tout cet espace qu'on peut garder
                     pour le pattern viewer." — largeur FIXE plutôt que proportionnelle
                     (1.2* auparavant) : tout l'espace supplémentaire de la fenêtre va
                     désormais à la colonne Player (utile notamment en plein écran, cf.
                     WantsFullWidth). -->
                <ColumnDefinition Width="300" MinWidth="260"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════ Colonne 1 : Formats ══════════════════════ -->
            <Grid Grid.Column="0" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toggle Par format / Par auteur -->
                <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,10">
                    <Button Content="{DynamicResource Modland_ByFormat}"
                            Command="{Binding SetFormatModeCommand}"
                            FontSize="10" Padding="0,6" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuthorMode}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Modland_ByAuthor}"
                            Command="{Binding SetAuthorModeCommand}"
                            FontSize="10" Padding="0,6" Margin="3,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuthorMode}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <TextBox Grid.Row="1" Margin="0,0,0,8" Padding="6,5"
                         Text="{Binding FormatFilter, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsAuthorMode, Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Liste des formats (mode "Par format") -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleFormats}"
                         SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsAuthorMode, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:ModlandNameCount}">
                            <DockPanel Margin="2,3">
                                <!-- 2026-08-01, retour utilisateur ("il faut rajouter un espace
                                     pour l'espacé du nom [...] en mode dark le choix de la
                                     couleur ne le rend pas très lisible") : Margin gauche pour
                                     séparer du nom, TextSecondary (#9090A8 en dark) au lieu de
                                     TextMuted (#5A5A70 en dark, trop peu contrasté) — taille
                                     inchangée (FontSize="10"). -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="10"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Placeholder en mode "Par auteur" — la colonne Formats ne sert
                     pas dans ce mode (recherche globale sur tous formats). -->
                <TextBlock Grid.Row="2" Text="{DynamicResource Modland_AuthorModeHint}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" Margin="2,8"
                           Visibility="{Binding IsAuthorMode, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource Border}"/>

            <!-- ══════════════════════ Colonne 2 : Auteurs ═══════════════════════ -->
            <Grid Grid.Column="2" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Modland_Authors}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                <TextBox Grid.Row="1" Margin="0,0,0,8" Padding="6,5"
                         Text="{Binding AuthorSearch, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 2026-08-06, retour utilisateur ("dans le repertoire HSVC il y a un
                     repertoire 'MUSICIANS' mais il ne fait pas apparaitre les
                     repertoires sous ce sous repertoire") : certains "auteurs" sont en
                     réalité des dossiers virtuels à plusieurs niveaux (HVSC :
                     MUSICIANS/Lettre/Artiste) — fil d'Ariane + bouton "remonter",
                     visible uniquement une fois descendu d'au moins un niveau. -->
                <DockPanel Grid.Row="2" Margin="0,0,0,8"
                           Visibility="{Binding CanGoUpAuthorFolder, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Left" Content="⬅" Width="24" Height="24" Padding="0"
                            Style="{StaticResource IconButton}" FontSize="12"
                            Command="{Binding GoUpAuthorFolderCommand}"
                            ToolTip="{DynamicResource Modland_GoUpFolder}"/>
                    <TextBlock Text="{Binding AuthorBreadcrumb}" FontSize="10" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMuted}"/>
                </DockPanel>

                <ListBox x:Name="AuthorsListBox" Grid.Row="3"
                         ItemsSource="{Binding Authors}"
                         SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:ModlandNameCount}">
                            <DockPanel Margin="2,3">
                                <!-- 2026-08-01, retour utilisateur : même correctif que la
                                     colonne Formats (espacement + TextSecondary au lieu de
                                     TextMuted, taille inchangée). -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="10"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource Border}"/>

            <!-- ══════════════════════ Colonne 3 : Pistes ════════════════════════ -->
            <Grid Grid.Column="4" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Modland_Tracks}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Modland_PlayAll}"
                            Style="{StaticResource AccentButton}" FontSize="10" Padding="10,5"
                            Command="{Binding PlayAllTracksCommand}"
                            IsEnabled="{Binding HasTracks}"/>
                </DockPanel>

                <!-- 2026-08-06, retour utilisateur ("quand la liste des fichiers depassent
                     1000 entrées, ça bloque l'application et même le PC") : cet
                     ItemsControl était auparavant hébergé dans un simple ScrollViewer,
                     SANS virtualisation — WPF construisait alors l'arbre visuel complet
                     (Border+Style+DataTriggers+DockPanel+3 TextBlocks+Bouton) pour
                     CHAQUE piste d'un coup, même celles hors écran. Pour un auteur avec
                     des dizaines de milliers de pistes (typiquement HVSC/MUSICIANS,
                     cf. GetAuthorSubfoldersAsync ci-dessus, qui réduit déjà
                     drastiquement ce cas en particulier), ça pouvait représenter des
                     dizaines de milliers de contrôles réels créés en synchrone sur le
                     thread UI — d'où le blocage complet de l'appli, et la pression
                     mémoire/GC suffisamment lourde pour ralentir tout le PC. Remplacé
                     par un ItemsControl auto-défilant avec VirtualizingStackPanel :
                     seules les lignes réellement visibles (+ une petite marge) sont
                     matérialisées, quel que soit le nombre total de pistes. -->
                <ItemsControl x:Name="TracksItemsControl" Grid.Row="1"
                              ItemsSource="{Binding Tracks}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.IsContainerVirtualizable="True"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModlandTrackItemViewModel}">
                                <Border Padding="8,6" Margin="0,0,0,4"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        BorderThickness="3,0,0,0"
                                        BorderBrush="Transparent">
                                    <!-- 2026-07-30, demande utilisateur : "peux tu highlighter le
                                         fichier en cours de lecture ?" + "quand tu lance le
                                         telecharger peux tu changer l'icone ou l'afficher quelque
                                         part ? [...] on l'impression qu'il ne fait rien" — fond de
                                         la ligne teinté aussi pendant le téléchargement (pas
                                         seulement l'icône ⬇, cf. plus bas), en plus du curseur
                                         souris "Attente" (cf. ModlandBrowserViewModel.PlayTrack).
                                         2026-08-06, retour utilisateur ("highlight pas assez
                                         visible") : le simple fond teinté (AccentSubtle) passait
                                         inaperçu — ajout d'une barre verticale pleine couleur
                                         Accent sur le bord gauche (BorderThickness="3,0,0,0",
                                         convention "now playing" courante) + icône ▶ devant le
                                         nom de fichier (cf. DockPanel ci-dessous), en plus du
                                         fond et du texte en gras déjà en place. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Track.Extension}"
                                                   FontSize="9" FontFamily="{StaticResource FontMono}"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Width="24" Height="24" Padding="0"
                                                Style="{StaticResource IconButton}" FontSize="12"
                                                Margin="4,0,0,0"
                                                ToolTip="{DynamicResource Modland_ToggleFavorite}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="♡"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="♥"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Modland_Downloading}"
                                                   FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="⬇" FontSize="16" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- 2026-08-06, retour utilisateur ("highlight pas assez
                                             visible") : icône ▶ devant le nom, en plus de la barre
                                             de bord + du fond teinté + du texte en gras déjà en
                                             place — cf. commentaire sur Border.Style plus haut. -->
                                        <TextBlock DockPanel.Dock="Left" Text="▶" FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Visibility="{Binding IsCurrentlyPlaying,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Track.FileName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   MouseLeftButtonUp="TrackText_MouseLeftButtonUp">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>

            <Border Grid.Column="5" Background="{DynamicResource Border}"/>

            <!-- ══════════════════════ Colonne 4 : Player ════════════════════════ -->
            <Grid Grid.Column="6" Margin="14,12">
                <ContentControl Content="{Binding Player}"
                                Visibility="{Binding Player, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{DynamicResource Modland_NoTrackPlaying}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Player, Converter={StaticResource InverseNullToVisibility}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
