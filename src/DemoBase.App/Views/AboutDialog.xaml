<Window x:Class="DemoBase.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DemoBase.App"
        Title="À propos de DemoBase"
        Width="400" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="32,28">

        <!-- Titre + version -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="DemoBase" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{x:Static app:DebugHelper.AppVersion}"
                       FontSize="13" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Bottom" Margin="10,0,0,4"/>
        </StackPanel>

        <TextBlock Text="Scene Archive Manager" FontSize="12"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,24"/>

        <!-- Infos DB -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base de données" 
                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,12,6"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDbVersion"
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Releases"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,12,6"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtReleaseCount"
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,12,6"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 8 / WPF"
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
        </Grid>

        <Separator Margin="0,12,0,16" Background="{DynamicResource Border}"/>

        <TextBlock Text="© 2024-2026 — Tous droits réservés"
                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,16"/>

        <Button Content="Fermer" Click="CloseButton_Click"
                HorizontalAlignment="Right"
                Padding="24,8" FontSize="12"
                Background="{DynamicResource Accent}"
                Foreground="White" BorderThickness="0"/>
    </StackPanel>
</Window>
