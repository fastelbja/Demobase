<Window x:Class="DemoBase.App.Views.FullPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Pattern View"
        Height="700"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown"
        Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1A1A1A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock x:Name="TitleLabel"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#888888"/>
                <TextBlock Text="   ·   Échap pour fermer"
                           FontSize="10" Foreground="#444444"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="✕" HorizontalAlignment="Right"
                    Width="22" Height="22" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#666666" FontSize="11"
                    Click="Close_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <ContentPresenter x:Name="PatternHost"/>
        </Grid>
    </Grid>
</Window>
