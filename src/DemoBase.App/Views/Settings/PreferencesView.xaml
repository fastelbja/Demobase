<UserControl x:Class="DemoBase.App.Views.Settings.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgApp}">
    <!-- Grid (et non un simple ScrollViewer) : le bouton "Sauvegarder" doit rester
         visible en permanence dans une barre fixe en bas, plutôt que d'être le
         dernier élément du contenu défilant — sur une fenêtre pas assez haute, il
         fallait scroller tout en bas pour le voir, et un changement de chemin fait
         en haut de page pouvait donc être silencieusement perdu si on quittait la
         page sans avoir pensé à scroller. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource SlimScrollViewer}">
        <StackPanel MaxWidth="680" Margin="32,24,32,12">

            <!-- Titre -->
            <TextBlock Text="{DynamicResource Pref_Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,24"/>

            <!-- ── Chemins ─────────────────────────────────────────────────── -->
            <TextBlock Text="{DynamicResource Pref_Paths}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}" Padding="20,16"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- Configs -->
                    <TextBlock Text="{DynamicResource Pref_EmuConfigs}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_EmuConfigsDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseConfigsCommand}"/>
                        <TextBox Text="{Binding PathConfigs, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- Émulateurs -->
                    <TextBlock Text="{DynamicResource Pref_Emulators}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_EmulatorsDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseEmulatorsCommand}"/>
                        <TextBox Text="{Binding PathEmulators, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- Images -->
                    <TextBlock Text="{DynamicResource Pref_Images}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_ImagesDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseImagesCommand}"/>
                        <TextBox Text="{Binding PathImages, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- DATs -->
                    <TextBlock Text="{DynamicResource Pref_DATs}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_DATsDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseDatsCommand}"/>
                        <TextBox Text="{Binding PathDats, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- Releases -->
                    <TextBlock Text="{DynamicResource Pref_Releases}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_ReleasesDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseReleasesCommand}"/>
                        <TextBox Text="{Binding PathReleases, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- RECOIL -->
                    <TextBlock Text="{DynamicResource Pref_Recoil}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,4"/>
                    <TextBlock Text="{DynamicResource Pref_RecoilDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📂" Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseRecoilCommand}"/>
                        <TextBox Text="{Binding PathRecoil2Png, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="12" FontFamily="Consolas"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                </StackPanel>
            </Border>

            <!-- ── Interface ───────────────────────────────────────────────── -->
            <TextBlock Text="{DynamicResource Pref_Interface}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}" Padding="20,16"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- Thème -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_Theme}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_ThemeDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="{DynamicResource Pref_ThemeLight}" Margin="0,0,12,0"
                                         IsChecked="{Binding Theme,
                                             Converter={StaticResource EqualityConverter},
                                             ConverterParameter=Light}"/>
                            <RadioButton Content="{DynamicResource Pref_ThemeDark}"
                                         IsChecked="{Binding Theme,
                                             Converter={StaticResource EqualityConverter},
                                             ConverterParameter=Dark}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Effets démo -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_DemoEffects}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_DemoEffectsDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding DemoEffects}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Langue -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_Language}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_LanguageDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="🇫🇷 Français" Margin="0,0,12,0"
                                         IsChecked="{Binding Language,
                                             Converter={StaticResource EqualityConverter},
                                             ConverterParameter=fr}"/>
                            <RadioButton Content="🇬🇧 English"
                                         IsChecked="{Binding Language,
                                             Converter={StaticResource EqualityConverter},
                                             ConverterParameter=en}"/>
                        </StackPanel>
                    </DockPanel>

                </StackPanel>
            </Border>

            <!-- ── Vues / Favoris automatiques ────────────────────────────────── -->
            <TextBlock Text="{DynamicResource Pref_Views}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}" Padding="20,16"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- Seuil de favori automatique -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_AutoFavoriteThreshold}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_AutoFavoriteThresholdDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                        <TextBox Text="{Binding AutoFavoriteViewThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Padding="8,6" FontSize="12"
                                 HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- Durée diaporama Graphics -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_SlideshowDuration}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_SlideshowDurationDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                        <TextBox Text="{Binding SlideshowDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Padding="8,6" FontSize="12"
                                 HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                                 Background="{DynamicResource BgHover}"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                    </DockPanel>

                    <!-- Reset vus -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_ResetViews}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_ResetViewsDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResetViewsStatus}" FontSize="11"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource Pref_ResetViewsButton}" Padding="12,6"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding ResetViewCountsCommand}"/>
                        </StackPanel>
                    </DockPanel>

                </StackPanel>
            </Border>

            <!-- ── UADE ────────────────────────────────────────────────────────── -->
            <!-- 2026-08-06/07, retours utilisateur successifs : gain (UC_GAIN) puis
                 panoramique stéréo (UC_PANNING_VALUE, déplacé depuis l'écran de lecture
                 — "peux tu faire de meme pour le 'Panoramique' [...] et enleve le du
                 player. Crée du coup une section 'UADE' dans les préférences pour
                 mettre le panoramique et le replay gain.") — les deux seuls réglages
                 propres au backend UADE (formats Amiga exotiques : TFMX, MDAT…),
                 regroupés dans leur propre section plutôt que sur l'écran de lecture
                 (SoundtrackPlayerView), déjà chargé. -->
            <TextBlock Text="{DynamicResource Pref_Audio}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}" Padding="20,16"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- Gain -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_UadeGain}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_UadeGainDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UadeGainAmount, StringFormat={}{0:0.0}x}"
                                       FontSize="12" FontFamily="Consolas" Width="34"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                            <Slider Width="140" Minimum="1.0" Maximum="3.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding UadeGainAmount, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="1.0 = son d'origine UADE, sans amplification"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Panoramique stéréo -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{DynamicResource Pref_UadePanning}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Pref_UadePanningDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding UadePanningEnabled}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Activer le panoramique adouci"/>
                            <TextBlock Text="{Binding UadePanningAmount, StringFormat={}{0:0.00}}"
                                       FontSize="12" FontFamily="Consolas" Width="34"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                            <Slider Width="140" Minimum="0" Maximum="2"
                                    TickFrequency="0.1" IsSnapToTickEnabled="False"
                                    IsEnabled="{Binding UadePanningEnabled}"
                                    VerticalAlignment="Center"
                                    Value="{Binding UadePanningAmount, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="0 = son d'origine, 2 = mixage complet en mono"/>
                        </StackPanel>
                    </DockPanel>

                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ── Actions — barre fixe, toujours visible sans avoir à scroller ──── -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel MaxWidth="680" Margin="32,14">
                <Button DockPanel.Dock="Right" Content="{DynamicResource App_Save}"
                        Style="{StaticResource AccentButton}" Padding="16,8"
                        Command="{Binding SaveCommand}"/>
                <Button Content="{DynamicResource App_Reset}" Padding="12,8" Margin="0,0,8,0"
                        HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Command="{Binding ResetCommand}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
