<UserControl x:Class="DemoBase.App.Views.Library.PartyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgApp}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <TextBlock Text="{DynamicResource Nav_Parties}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="8,3"
                        Background="{DynamicResource BgHover}" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text="{DynamicResource Count_Parties}"/>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,10"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <TextBox x:Name="SearchBox" Tag="search" Style="{StaticResource SearchBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
        </Border>

        <!-- Tri Alpha/Date — toujours visible, indépendant du filtre par année -->
        <Border DockPanel.Dock="Top" Padding="16,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{DynamicResource RD_SortPrefix}" FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource FilterChip}"
                                  Content="{DynamicResource RL_SortAZ}"
                                  Padding="8,3" Margin="0,0,4,0"
                                  IsChecked="{Binding SortByAlpha, Mode=OneWay}"
                                  Command="{Binding SetSortCommand}"
                                  CommandParameter="alpha"/>
                    <ToggleButton Style="{StaticResource FilterChip}"
                                  Content="{DynamicResource RL_SortDate}"
                                  Padding="8,3"
                                  IsChecked="{Binding SortByDate, Mode=OneWay}"
                                  Command="{Binding SetSortCommand}"
                                  CommandParameter="date"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Chips d'années -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding YearChips.Count,
                    Converter={StaticResource NullToVisibility}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <!-- Chip "Tous" -->
                    <Border x:Name="ChipAll" CornerRadius="12" Padding="12,4"
                            Margin="0,0,5,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                Command="{Binding SelectYearCommand}"
                                CommandParameter="{x:Null}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedYear}" Value="{x:Null}">
                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource RL_All}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedYear}" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Chips par année -->
                    <ItemsControl ItemsSource="{Binding YearChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Chip" CornerRadius="12" Padding="12,4"
                                        Margin="0,0,5,0" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.SelectYearCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource BgHover}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="100" Height="3"
                         HorizontalAlignment="Left" BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"/>
        </Border>
        <ScrollViewer x:Name="Scroll"
 Style="{StaticResource SlimScrollViewer}"
                      ScrollChanged="Scroll_ScrollChanged">
            <StackPanel>
                <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBd" Padding="20,12"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                        Command="{Binding DataContext.OpenPartyCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding PartySeries.Name}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextAccent}"
                                                       Margin="0,0,8,0"
                                                       Visibility="{Binding PartySeries,
                                                           Converter={StaticResource NullToVisibility}}"/>
                                            <TextBlock Text="{Binding Location}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Visibility="{Binding Location,
                                                           Converter={StaticResource NullToVisibility}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StartDate}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right"/>
                                        <!-- Nombre de releases -->
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding ReleaseCount, Mode=OneWay}"/>
                                            <Run Text="releases"/>
                                        </TextBlock>
                                        <!-- Badge online -->
                                        <Border CornerRadius="3" Padding="5,1" Margin="0,3,0,0"
                                                Background="{DynamicResource BgHover}"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding IsOnline,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource Party_Online}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Sélection clavier : déclaré avant IsMouseOver pour
                                     que la bordure Accent reste visible même sous la souris. -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource ReferenceEquality}">
                                            <Binding Path="."/>
                                            <Binding Path="DataContext.SelectedItem"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="ItemBd" Property="Background"
                                            Value="{DynamicResource BgSelected}"/>
                                    <Setter TargetName="ItemBd" Property="BorderBrush"
                                            Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="ItemBd" Property="BorderThickness"
                                            Value="2,0,0,0"/>
                                </DataTrigger>
                                <Trigger SourceName="ItemBd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background"
                                            Value="{DynamicResource BgHover}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Padding="20,10"
                        Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                 HorizontalAlignment="Center" BorderThickness="0"
                                 Foreground="{DynamicResource Accent}"
                                 Background="{DynamicResource BgHover}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
