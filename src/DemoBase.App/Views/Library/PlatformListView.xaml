<UserControl x:Class="DemoBase.App.Views.Library.PlatformListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgApp}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <TextBlock Text="{DynamicResource Nav_Platforms}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="8,3"
                        Background="{DynamicResource BgHover}" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                        <Run Text="{Binding Platforms.Count, Mode=OneWay}"/>
                        <Run Text="{DynamicResource Count_Platforms}"/>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,10"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <TextBox Style="{StaticResource SearchBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="100" Height="3"
                         HorizontalAlignment="Left" BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"/>
        </Border>
        <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="16,12">
            <ItemsControl ItemsSource="{Binding Platforms}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="150" Height="130" Margin="0,0,12,12"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.FilterByPlatformCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel VerticalAlignment="Center" Margin="10">
                                <!-- Icône de plateforme — taille fixe identique pour toutes,
                                     jamais recadrée (Uniform = aspect ratio préservé, tient
                                     entièrement dans le cadre). Masquée s'il n'y a pas d'image
                                     pour cette plateforme (cf. PlatformHasIcon). -->
                                <Border Width="72" Height="72" Margin="0,0,0,10"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding Name, Converter={StaticResource PlatformHasIcon}}">
                                    <Image Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Source>
                                            <Binding Path="Name" Converter="{StaticResource PlatformIcon}"/>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <TextBlock x:Name="PlatformName" Text="{Binding Name}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           MaxWidth="130"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Fond rouge subtil pour les plateformes SANS AUCUNE config
                                 (2026-07-24) — cf. Platform.HasEmulatorConfig (Models.cs),
                                 calculé par PlatformListViewModel.LoadAsync depuis les vraies
                                 EmulatorConfig en base (remplace l'ancienne liste de noms figée
                                 PlatformNotEmulatedConverter). Placé AVANT le Trigger de survol
                                 ci-dessous : au survol, le fond bascule quand même sur BgHover
                                 (retour visuel de clic conservé partout). -->
                            <DataTrigger Binding="{Binding HasEmulatorConfig}"
                                         Value="False">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource BgDanger}"/>
                            </DataTrigger>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource BgHover}"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderFocus}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
