<Window x:Class="DemoBase.App.Views.Releases.FilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FPick_Title}"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}">

    <!-- 2026-07-25 : fenêtre affichée au clic sur "Lancer" quand une release a
         plusieurs fichiers (DatEntry) lançables ET qu'aucun n'a encore été
         explicitement choisi (ni via le bouton "Utiliser" dans l'onglet Fichiers, ni
         via un choix mémorisé lors d'un lancement précédent) — cf.
         ReleaseDetailViewModel.LaunchAsync / BuildFilePickerEntriesAsync. Le fichier
         choisi ici est mémorisé durablement (ReleasePreferredFiles) : il ne sera plus
         jamais redemandé pour cette release tant qu'il reste présent parmi ses
         fichiers. -->
    <StackPanel Margin="24">

        <TextBlock Text="{DynamicResource FPick_Heading}"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"/>

        <TextBlock Text="{DynamicResource FPick_Body}"
                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap" Margin="0,10,0,14"/>

        <ListBox x:Name="FilesListBox"
                 ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry}"
                 BorderThickness="0" Background="Transparent"
                 MaxHeight="320"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBd"
                                        Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="10,8"
                                        ToolTip="{Binding ContentsTooltip}"
                                        ToolTipService.InitialShowDelay="300"
                                        ToolTipService.ShowDuration="60000">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="RowBd" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource FontMono}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PlatformLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Dlg_Cancel}" FontSize="12" Padding="14,7" Margin="0,0,8,0"
                    Style="{StaticResource IconButton}"
                    Click="Cancel_Click"/>
            <Button Content="{DynamicResource Dlg_Launch}" FontSize="12" Padding="18,7"
                    Style="{StaticResource AccentButton}"
                    Click="Launch_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
