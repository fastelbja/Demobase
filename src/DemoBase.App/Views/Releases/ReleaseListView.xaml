<UserControl x:Class="DemoBase.App.Views.Releases.ReleaseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgApp}">

    <!-- La colonne détail est désormais la colonne droite fixe de MainWindow.
         Cette vue n'affiche plus que la liste. -->
    <Border Background="{DynamicResource BgPanel}">
            <DockPanel>

                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="12,10"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource Nav_Releases}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <!-- Badge filtre type actif -->
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="7,3" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedTypeName,
                                    Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextAccent}"
                                           VerticalAlignment="Center">
                                    <Run Text="🎬 "/>
                                    <Run Text="{Binding SelectedTypeName, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Style="{StaticResource LinkButton}"
                                        Content=" ✕" FontSize="10" Padding="2,0"
                                        Command="{Binding ClearTypeFilterCommand}"/>
                            </StackPanel>
                        </Border>
                        <!-- Badge filtre plateforme actif -->
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="7,3" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedPlatformName,
                                    Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextAccent}"
                                           VerticalAlignment="Center">
                                    <Run Text="📺 "/>
                                    <Run Text="{Binding SelectedPlatformName, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Style="{StaticResource LinkButton}"
                                        Content=" ✕" FontSize="10" Padding="2,0"
                                        Command="{Binding ClearPlatformFilterCommand}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="Releases.Count"/>
                                    <Binding Path="TotalCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Recherche -->
                <Border DockPanel.Dock="Top" Padding="10,8,10,6"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <TextBox x:Name="SearchBox" Tag="search"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Border>

                <!-- Filtre type de release -->
                <Border DockPanel.Dock="Top" Padding="10,6"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <ComboBox ItemsSource="{Binding AvailableTypes}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedReleaseTypeId}"
                              FontSize="12"/>
                </Border>

                <!-- Filtres supertype -->
                <Border DockPanel.Dock="Top" Padding="10,6"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource FilterChip}" Content="{DynamicResource RL_All}"
                                      Margin="0,0,4,4"
                                      IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                      Command="{Binding FilterBySupertypeCommand}"
                                      CommandParameter="{x:Null}"/>
                        <ToggleButton Style="{StaticResource FilterChip}" Content="{DynamicResource RL_Demos}"
                                      Margin="0,0,4,4"
                                      IsChecked="{Binding IsProductionSelected, Mode=OneWay}"
                                      Command="{Binding FilterBySupertypeCommand}"
                                      CommandParameter="production"/>
                        <ToggleButton Style="{StaticResource FilterChip}" Content="{DynamicResource RL_Graphics}"
                                      Margin="0,0,4,4"
                                      IsChecked="{Binding IsGraphicsSelected, Mode=OneWay}"
                                      Command="{Binding FilterBySupertypeCommand}"
                                      CommandParameter="graphics"/>
                        <ToggleButton Style="{StaticResource FilterChip}" Content="{DynamicResource RL_Music}"
                                      Margin="0,0,4,4"
                                      IsChecked="{Binding IsMusicSelected, Mode=OneWay}"
                                      Command="{Binding FilterBySupertypeCommand}"
                                      CommandParameter="music"/>
                    </WrapPanel>

                    <!-- Tri -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource RD_SortPrefix}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource FilterChip}"
                                      IsChecked="{Binding SortBy,
                                          Converter={StaticResource EqualityConverter},
                                          ConverterParameter=Title, Mode=TwoWay}"
                                      Command="{Binding ToggleSortCommand}"
                                      CommandParameter="Title"
                                      Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource RL_SortAZ}"/>
                                <TextBlock Text=" ↑" FontSize="9"
                                           Visibility="{Binding SortBy,
                                               Converter={StaticResource EqualityConverter},
                                               ConverterParameter=Title}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource FilterChip}"
                                      IsChecked="{Binding SortBy,
                                          Converter={StaticResource EqualityConverter},
                                          ConverterParameter=Date, Mode=TwoWay}"
                                      Command="{Binding ToggleSortCommand}"
                                      CommandParameter="Date">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource RL_SortDate}"/>
                                <TextBlock Text=" ↓" FontSize="9"
                                           Visibility="{Binding SortBy,
                                               Converter={StaticResource EqualityConverter},
                                               ConverterParameter=Date}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Filtre "Non vu" — ne montre que les releases jamais
                         lancées/jouées (compteur de vues à 0) -->
                    <CheckBox Content="{DynamicResource RL_UnseenOnly}"
                              IsChecked="{Binding IsUnseenOnly}"
                              FontSize="11" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Chips d'années -->
                <Border DockPanel.Dock="Top" Padding="10,8"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding YearChips.Count,
                            Converter={StaticResource NullToVisibility}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <!-- Chip "Tous" -->
                            <Border CornerRadius="12" Padding="12,4"
                                    Margin="0,0,5,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                        Command="{Binding SelectYearCommand}"
                                        CommandParameter="{x:Null}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedYear}" Value="{x:Null}">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{DynamicResource RL_All}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedYear}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Chips par année -->
                            <ItemsControl ItemsSource="{Binding YearChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4"
                                                Margin="0,0,5,0" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.SelectYearCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource BgHover}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Indicateur chargement initial -->
                <Border DockPanel.Dock="Top"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource BgHover}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{DynamicResource RD_Loading}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Liste virtualisée avec scroll infini -->
                <!-- VirtualizingStackPanel : ne rend que les items visibles -->
                <ScrollViewer x:Name="ListScrollViewer"
                              Style="{StaticResource SlimScrollViewer}"
                              ScrollChanged="ListScrollViewer_ScrollChanged">
                    <StackPanel>
                        <ItemsControl x:Name="ReleasesList"
                                      ItemsSource="{Binding Releases}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ItemBd"
                                            Padding="12,10"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectReleaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Colonne principale -->
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">

                                                <!-- Titre + icône type -->
                                                <DockPanel>
                                                    <TextBlock FontSize="13" Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               DockPanel.Dock="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"
                                                                        Value="{Binding ReleaseTypeName,
                                                                            Converter={StaticResource ReleaseTypeIcon}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ReleaseTypeName}" Value="">
                                                                        <Setter Property="Text"
                                                                                Value="{Binding Supertype,
                                                                                    Converter={StaticResource ReleaseTypeIcon}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <!-- Titre atténué : aucun fichier exploitable pour cette release
                                                                         (cf. badge 🚫 colonne droite) — repérable sans avoir à cliquer
                                                                         sur "Lancer" pour se prendre l'erreur "Fichier introuvable". -->
                                                                    <DataTrigger Binding="{Binding HasNoFile}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>

                                                <!-- Auteurs + badges plateforme -->
                                                <WrapPanel Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding AuthorNames}"
                                                               Foreground="{DynamicResource TextAccent}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="140"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Badge plateforme -->
                                                    <Border CornerRadius="3" Padding="5,1"
                                                            Background="{DynamicResource BgCard}"
                                                            BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="1"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding PlatformNames,
                                                                Converter={StaticResource NullToVisibility}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlatformNames}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="10"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Type + date -->
                                                <WrapPanel Margin="0,3,0,0">
                                                    <Border CornerRadius="3" Padding="5,1"
                                                            Background="{DynamicResource BgHover}"
                                                            Margin="0,0,5,0"
                                                            Visibility="{Binding ReleaseTypeName,
                                                                Converter={StaticResource NullToVisibility}}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ReleaseTypeName}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="10"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ReleaseDate,
                                                                   Converter={StaticResource ReleaseDate}}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Colonne droite : rang + favori -->
                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        MinWidth="36">
                                                <!-- Aucun fichier exploitable (ni DatEntry, ni ReleaseLink hors
                                                     référence vidéo) — évite de cliquer "Lancer" pour se prendre
                                                     l'erreur "Fichier introuvable" sur des releases qui n'ont
                                                     jamais rien eu de lançable côté Demozoo. -->
                                                <TextBlock Text="🚫"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Red}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,0,2"
                                                           ToolTip="Aucun fichier disponible pour cette release (référence vidéo uniquement, le cas échéant)"
                                                           Visibility="{Binding HasNoFile,
                                                               Converter={StaticResource BoolToVisibility}}"/>
                                                <!-- Vidéo locale -->
                                                <TextBlock Text="🎬"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,0,2"
                                                           ToolTip="Capture vidéo locale disponible"
                                                           Visibility="{Binding HasLocalVideo,
                                                               Converter={StaticResource BoolToVisibility}}"/>
                                                <!-- Favori -->
                                                <TextBlock Text="{Binding IsFavorite,
                                                               Converter={StaticResource FavoriteToStar}}"
                                                           Foreground="{DynamicResource Gold}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Right"/>
                                                <!-- Rang -->
                                                <TextBlock Text="{Binding BestRank,
                                                               Converter={StaticResource RankToString}}"
                                                           Foreground="{DynamicResource Gold}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding BestRank,
                                                               Converter={StaticResource RankToVisibility}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- Sélection clavier/souris : déclaré EN PREMIER
                                             pour avoir priorité sur IsMouseOver en WPF.
                                             On ajoute aussi un BorderBrush Accent pour le
                                             rendre bien visible même quand la souris survole
                                             un autre item. -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource ReferenceEquality}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext.SelectedRelease"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="ItemBd" Property="Background"
                                                    Value="{DynamicResource BgSelected}"/>
                                            <Setter TargetName="ItemBd" Property="BorderBrush"
                                                    Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="ItemBd" Property="BorderThickness"
                                                    Value="2,0,0,0"/>
                                        </DataTrigger>
                                        <!-- Hover souris : déclaré EN DERNIER — moins
                                             prioritaire que la sélection en WPF. -->
                                        <Trigger SourceName="ItemBd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background"
                                                    Value="{DynamicResource BgHover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Indicateur "chargement suite" en bas de liste -->
                        <Border Padding="12,8"
                                Visibility="{Binding IsLoadingMore,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                             Foreground="{DynamicResource Accent}"
                                             Background="{DynamicResource BgHover}"
                                             BorderThickness="0"/>
                                <TextBlock Text="{DynamicResource RD_LoadMore}" FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
    </Border>
</UserControl>
