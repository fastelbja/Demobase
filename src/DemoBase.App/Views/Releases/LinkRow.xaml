<UserControl x:Class="DemoBase.App.Views.Releases.LinkRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
        <DockPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextMuted}" FontSize="11"
                       Width="70" VerticalAlignment="Center"/>
            <Button Style="{StaticResource LinkButton}" FontSize="12"
                    Content="{Binding Url, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Click="Hyperlink_Click"/>
        </DockPanel>
    </Border>
</UserControl>
