<UserControl x:Class="DemoBase.App.Views.Releases.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:conv="clr-namespace:DemoBase.App.Converters"
             Background="{DynamicResource BgApp}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>       <!-- zone vidéo + liste -->
            <RowDefinition Height="Auto"/>    <!-- transport bar -->
        </Grid.RowDefinitions>

        <!-- ── Zone principale : liste gauche + vidéo droite ─────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Liste des vidéos ───────────────────────────────────────── -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                    Background="{DynamicResource BgPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="VIDÉOS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="12,14,12,8"/>
                    <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                        <ItemsControl ItemsSource="{Binding Playlist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VideoLinkDto}">
                                    <Border CornerRadius="{StaticResource RadiusMd}"
                                            Margin="4,1" Padding="8,7"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.PlayVideoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <!-- Hover -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                                    </Trigger>
                                                    <!-- Vidéo en cours de lecture -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding>
                                                                <MultiBinding.Converter>
                                                                    <conv:ReferenceEqualityConverter/>
                                                                </MultiBinding.Converter>
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedVideo"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background"    Value="{DynamicResource BgSelected}"/>
                                                        <Setter Property="BorderBrush"   Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Ligne 1 : icône source + indicateur lecture -->
                                            <DockPanel Margin="0,0,0,2">
                                                <!-- Bouton 🌐 pour YouTube/Vimeo -->
                                                <Button DockPanel.Dock="Right"
                                                        Content="🌐"
                                                        Style="{StaticResource IconButton}"
                                                        Padding="4,2" FontSize="11"
                                                        ToolTip="Ouvrir dans le navigateur"
                                                        Command="{Binding DataContext.PlayVideoCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding OpenInBrowser,
                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <!-- Ligne 2 : titre / label -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Zone vidéo ─────────────────────────────────────────────── -->
            <Grid Grid.Column="1" Background="Black">

                <!-- VideoView VLC — rempli à la demande via code-behind -->
                <vlc:VideoView x:Name="VlcVideoView" Background="Black"/>

                <!-- Spinner pendant le chargement -->
                <TextBlock Text="⏳ Chargement…"
                           FontSize="14" Foreground="#AAFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibility}}"/>

                <!-- Message d'erreur -->
                <Border Background="#CC1A1A1F" Padding="20,14"
                        CornerRadius="{StaticResource RadiusMd}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ErrorMessage,
                            Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12" Foreground="#FFFF6B6B"
                               TextWrapping="Wrap" MaxWidth="360"
                               TextAlignment="Center"/>
                </Border>

                <!-- Message "choisissez une vidéo" si rien n'est sélectionné -->
                <TextBlock Foreground="#55FFFFFF" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasMedia,
                               Converter={StaticResource InverseBoolToVisibility}}">
                    Aucune vidéo disponible pour cette release.
                </TextBlock>

                <TextBlock Foreground="#55FFFFFF" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasMedia}"   Value="True"/>
                                        <Condition Binding="{Binding IsPlaying}"  Value="False"/>
                                        <Condition Binding="{Binding IsPaused}"   Value="False"/>
                                        <Condition Binding="{Binding IsLoading}"  Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    Cliquez sur une vidéo pour lancer la lecture.
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ── Barre de transport ─────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- boutons nav -->
                    <ColumnDefinition Width="*"/>      <!-- seek + temps -->
                    <ColumnDefinition Width="Auto"/>   <!-- volume -->
                </Grid.ColumnDefinitions>

                <!-- Boutons ⏮ ⏹ ▶/⏸ ⏭ -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="⏮" Style="{StaticResource IconButton}" Padding="8,6"
                            Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding HasPrevious}"/>
                    <Button Content="⏹" Style="{StaticResource IconButton}" Padding="8,6"
                            Command="{Binding StopCommand}" Margin="2,0"/>
                    <Button Padding="10,6" Margin="2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Content" Value="▶"/>
                                <Setter Property="Command" Value="{Binding PlayCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="⏸"/>
                                        <Setter Property="Command" Value="{Binding PauseCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⏭" Style="{StaticResource IconButton}" Padding="8,6" Margin="2,0"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding HasNext}"/>
                </StackPanel>

                <!-- Seekbar + timecodes -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding PositionSeconds, Converter={StaticResource SecondsToTime}}"
                               FontSize="11" FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Slider Grid.Column="1"
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=OneWay}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationSeconds, Converter={StaticResource SecondsToTime}}"
                               FontSize="11" FontFamily="{StaticResource FontMono}"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Volume + Plein écran -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Padding="6,4" Command="{Binding ToggleMuteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="🔊"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Content" Value="🔇"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Slider Width="70" Minimum="0" Maximum="100"
                            Value="{Binding Volume}"
                            VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Button Content="⛶" Style="{StaticResource IconButton}"
                            Padding="8,6" Margin="8,0,0,0"
                            ToolTip="Plein écran (ESC pour quitter)"
                            x:Name="FullscreenBtn"
                            Click="FullscreenBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
