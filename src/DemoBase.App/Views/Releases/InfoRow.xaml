<UserControl x:Class="DemoBase.App.Views.Releases.InfoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
            Padding="0,6">
        <DockPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextMuted}" FontSize="11"
                       Width="90" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextPrimary}" FontSize="12"
                       TextWrapping="Wrap"/>
        </DockPanel>
    </Border>
</UserControl>
