<UserControl x:Class="DemoBase.App.Views.Releases.ReleaseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DemoBase.App.Views.Releases"
             xmlns:ctrl="clr-namespace:DemoBase.App.Controls"
             xmlns:tp="clr-namespace:TrackerPlayer.UI.Controls;assembly=TrackerPlayer.UI"
             xmlns:vrel="clr-namespace:DemoBase.App.Views.Releases"
             xmlns:app="clr-namespace:DemoBase.App"
             xmlns:behaviors="clr-namespace:DemoBase.App.Behaviors"
             Background="{DynamicResource BgApp}">

    <Grid>
    <DockPanel>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel VerticalAlignment="Bottom">

                <!-- Boutons : View / Play / ★ — alignés en bas à droite -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <!-- Bouton principal Play/Afficher/Regarder/Lancer — le contenu est
                         résolu via LaunchLabel (propriété calculée sur IsMusic/IsGraphics/
                         IsVideo dans le ViewModel) pour éviter les problèmes de résolution
                         tardive des DynamicResource dans les DataTriggers. -->
                    <Button Style="{StaticResource AccentButton}"
                            Content="{Binding LaunchLabel}"
                            Command="{Binding LaunchCommand}" Margin="0,0,6,0" Padding="12,6"
                            Visibility="{Binding HasAnyFile, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- 🔧 Debug uniquement (2026-07-27, demande utilisateur) : lien affichant
                         l'ID Demozoo de la release, ouvre sa fiche demozoo.org dans le
                         navigateur — pratique pour vérifier rapidement les données source
                         (liens, link_class/link_parameter…) pendant une session de diagnostic.
                         Double condition : DebugHelper.IsDebugMode (masqué en Release, même
                         pattern que le bouton "Télécharger" debug de l'onglet Captures) ET
                         DemozooIdDebugLabel non-null (release sans DemozooId → rien à afficher). -->
                    <Border Margin="0,0,6,0">
                        <Border.Visibility>
                            <Binding Source="{x:Static app:DebugHelper.IsDebugMode}"
                                     Converter="{StaticResource BoolToVisibility}"/>
                        </Border.Visibility>
                        <Button Style="{StaticResource LinkButton}"
                                Content="{Binding DemozooIdDebugLabel}"
                                Command="{Binding OpenDemozooDebugPageCommand}"
                                Padding="6,6" FontSize="11"
                                ToolTip="{Binding DemozooDebugUrl}"
                                Visibility="{Binding DemozooIdDebugLabel, Converter={StaticResource NullToVisibility}}"/>
                    </Border>
                    <!-- 💾 Bouton secondaire : disquette/exécutable détecté dans l'archive
                         d'une release music/graphics ordinaire (cohabite avec Play/View
                         ci-dessus plutôt que de le remplacer) -->
                    <Button Style="{StaticResource GreenButton}"
                            Content="{DynamicResource RD_LaunchCompanion}"
                            Command="{Binding LaunchCompanionCommand}"
                            Margin="0,0,6,0" Padding="12,6"
                            ToolTip="{DynamicResource RD_LaunchCompanionTooltip}"
                            Visibility="{Binding HasLaunchableCompanion, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- 🎬 Bouton secondaire : vidéo (souvent une capture) détectée dans
                         l'archive d'une release ordinaire — utile si l'émulation ne
                         fonctionne pas (demande utilisateur). Cohabite avec Lancer/Play/View
                         ci-dessus plutôt que de le remplacer, comme le bouton disquette. -->
                    <Button Style="{StaticResource GreenButton}"
                            Content="{DynamicResource RD_PlayVideo}"
                            Command="{Binding PlayVideoCompanionCommand}"
                            Margin="0,0,6,0" Padding="12,6"
                            ToolTip="{DynamicResource RD_PlayVideoCompanionTooltip}"
                            Visibility="{Binding HasVideoCompanion, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- ★ Production/Graphique : IsFavorite standard -->
                    <Button Style="{StaticResource IconButton}"
                            Content="{Binding Detail.Release.IsFavorite, Converter={StaticResource FavoriteToStar}}"
                            Command="{Binding ToggleFavoriteCommand}"
                            Padding="10,6" FontSize="15"
                            Visibility="{Binding IsMusic, Converter={StaticResource InverseBoolToVisibility}}"
                            ToolTip="Ajouter aux favoris"/>
                    <!-- 🖼 ★ Graphique : favori graphique dédié -->
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ToggleGraphicFavoriteCommand}"
                            Padding="10,6" FontSize="15"
                            Visibility="{Binding IsGraphics, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Ajouter aux graphiques favoris">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🖼 ☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGraphicFavorite}" Value="True">
                                            <Setter Property="Text" Value="🖼 ★"/>
                                            <Setter Property="Foreground" Value="#F5C518"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <!-- ♪ ★ Musique -->
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ToggleMusicFavoriteCommand}"
                            Padding="10,6" FontSize="15"
                            Visibility="{Binding IsMusic, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Ajouter aux soundtracks favoris">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="♪ ☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMusicFavorite}" Value="True">
                                            <Setter Property="Text" Value="♪ ★"/>
                                            <Setter Property="Foreground" Value="#F5C518"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <!-- Titre + auteurs + badges -->
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Detail.Release.Title}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <ItemsControl ItemsSource="{Binding Detail.Authors}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}"
                                        Content="{Binding ReleaserName}" FontSize="13"
                                        Command="{Binding DataContext.OpenReleaserCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ReleaserId}"
                                        Margin="0,0,6,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                            <TextBlock Foreground="{DynamicResource Accent}" FontSize="11"
                                       Text="{Binding Detail.Release.ReleaseType.Name,
                                           Converter={StaticResource NullToWild}}"/>
                        </Border>
                        <!-- 2026-07-25 : release pas encore couverte par un DAT (le DAT n'est
                             reconstruit qu'~1x/mois, Demozoo l'est plus souvent) mais jouable via
                             téléchargement direct du lien Demozoo — cf. RESUME_PROJET.md,
                             IsExternalOnlyRelease dans ReleaseDetailViewModel. -->
                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource Red}" BorderThickness="1"
                                Visibility="{Binding IsExternalOnlyRelease, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Pas encore de DAT pour cette release — fichier récupéré directement depuis Demozoo au lancement, non vérifié par contrôle CRC (contrairement aux fichiers du DAT/Mega).">
                            <TextBlock Foreground="{DynamicResource Red}" FontSize="11"
                                       Text="Fichier externe (pas encore de DAT)"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Detail.Release.ReleasePlatforms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,5,0">
                                        <Button Style="{StaticResource LinkButton}"
                                                Content="{Binding Platform.Name}"
                                                FontSize="11" Padding="0"
                                                ToolTip="Voir toutes les releases de cette plateforme"
                                                Command="{Binding DataContext.FilterByPlatformCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Platform}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Detail.Release.ReleaseDate,
                                       Converter={StaticResource ReleaseDate}}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <!-- Compteur de vues — visible uniquement si déjà vu au moins une fois -->
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip="Nombre de fois où Play/Afficher/Regarder/Lancer a été cliqué">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Detail.Release.ViewCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="👁"/>
                            <Run Text="{Binding Detail.Release.ViewCount, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>

                    <!-- ── Override du profil de lancement ──────────────────────────
                         2026-07-25 : n'est plus limité au mode debug (retour utilisateur :
                         seul moyen de choisir la plateforme sur une release multi-plateforme,
                         mais invisible en build Release). Porte sur le FICHIER sélectionné
                         dans l'onglet Fichiers (SelectedDatEntry) quand il y en a un, sur la
                         release entière sinon — cf. ProfileOverrideLabel/HasActiveProfileOverride. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProfileOverrideLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding AvailableProfilesForOverride}"
                                  SelectedItem="{Binding SelectedOverrideProfile}"
                                  Style="{StaticResource FlatComboBox}"
                                  MinWidth="200" FontSize="11">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Emulator.Name, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding ProfileName, Mode=OneWay}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Platform.Name, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Appliquer" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ApplyProfileOverrideCommand}"/>
                        <Button Content="Réinitialiser" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ResetProfileOverrideCommand}"
                                Visibility="{Binding HasActiveProfileOverride,
                                    Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="(override actif)" FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding HasActiveProfileOverride,
                                       Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Reset Files : efface le fichier de démarrage mémorisé (WinUAE HD /
                             DosBoxX) pour cette release, quel que soit le profil utilisé au
                             moment du choix — permet de revenir sur un mauvais choix de fichier,
                             le sélecteur réapparaîtra au prochain lancement. Toujours visible
                             (pas seulement quand un choix est détecté) pour être sûr de pouvoir
                             forcer le reset même en cas de doute. -->
                        <Button Content="Reset Files" FontSize="11" Padding="8,4" Margin="14,0,0,0"
                                Style="{StaticResource IconButton}"
                                Command="{Binding ResetWinUAEStartupFileCommand}"
                                ToolTip="Effacer le fichier de démarrage mémorisé (WinUAE HD / DosBoxX) pour cette release — le sélecteur de fichier réapparaîtra au prochain lancement"/>
                        <TextBlock FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding HasWinUAEStartupChoice,
                                       Converter={StaticResource BoolToVisibility}}">
                            <Run Text="(mémorisé : "/>
                            <Run Text="{Binding WinUAEStartupChoiceLabel, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Onglets — toujours visibles ────────────────────────────────── -->
        <TabControl x:Name="MainTabs" DockPanel.Dock="Top" Background="Transparent"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource FlatTabItem}"/>
            </TabControl.ItemContainerStyle>

            <!-- ── Onglet Infos ─────────────────────────────────────────── -->
            <TabItem Header="{DynamicResource RD_Infos}">
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Colonne gauche -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RD_Information}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLg}" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6"
                                               Visibility="{Binding Detail.Release.ReleaseType,
                                                   Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Text="{DynamicResource RD_Type}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Width="80" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource LinkButton}"
                                                Content="{Binding Detail.Release.ReleaseType.Name, Converter={StaticResource NullToWild}}"
                                                FontSize="12"
                                                Command="{Binding FilterByTypeCommand}"
                                                CommandParameter="{Binding Detail.Release.ReleaseTypeId}"/>
                                    </DockPanel>
                                    <views:InfoRow Label="Supertype"
                                                   Value="{Binding Detail.Release.Supertype, Converter={StaticResource NullToWild}}"/>
                                    <views:InfoRow Label="Date"
                                                   Value="{Binding Detail.Release.ReleaseDate,
                                                       Converter={StaticResource ReleaseDate}}"/>
                                    <views:InfoRow Label="Tags"
                                                   Value="{Binding Detail.Release.Tags}"
                                                   Visibility="{Binding Detail.Release.Tags,
                                                       Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Notes Markdown -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding Detail.Release.Notes,
                                            Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{DynamicResource RD_Notes}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusLg}" Padding="12" MinHeight="60">
                                    <ctrl:MarkdownViewer Markdown="{Binding Detail.Release.Notes}"
                                                         Height="Auto" MinHeight="40"/>
                                </Border>
                            </StackPanel>

                            <!-- Liens — masqué à nouveau le 2026-07-24 à la demande de l'utilisateur
                                 (ne lui sert à rien) ; forcé à Collapsed plutôt que de dépendre de
                                 HasLinks, pour garder le bloc intact si jamais on veut le
                                 réactiver un jour. -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource RD_Links}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Detail.Links}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="12,8" Margin="0,0,0,6"
                                                    Cursor="Hand">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="⭐ principal" FontSize="10"
                                                                   Foreground="{DynamicResource Gold}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsMainFile,
                                                                       Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding LinkClass}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Url}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextLink}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding FileName,
                                                                   Converter={StaticResource NullToVisibility}}"/>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <TextBlock Text="copie locale"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   Visibility="{Binding IsLocalCopy,
                                                                       Converter={StaticResource BoolToVisibility}}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenReleaseLinkCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Colonne droite : compétitions -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RD_Competitions}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Detail.CompetitionPlacings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCard}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}"
                                                Padding="12,10" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Ranking, Converter={StaticResource RankToString}}"
                                                           Foreground="{DynamicResource Gold}"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <StackPanel>
                                                    <Button Style="{StaticResource LinkButton}"
                                                            Content="{Binding PartyName}"
                                                            FontSize="12" FontWeight="SemiBold"
                                                            Command="{Binding DataContext.OpenPartyCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding PartyId}"/>
                                                    <TextBlock Text="{Binding CompetitionName}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Onglet Crédits ───────────────────────────────────────── -->
            <TabItem Header="{DynamicResource RD_Credits}">
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RD_CreditsSection}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Detail.Credits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CreditBd"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding Role}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Width="120" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource LinkButton}"
                                                    Content="{Binding Handle}"
                                                    FontSize="12"
                                                    Command="{Binding DataContext.OpenReleaserCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ReleaserId}"/>
                                        </DockPanel>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource BgHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Onglet Used In — visible seulement si données ────────── -->
            <TabItem Header="{DynamicResource RD_UsedIn}"
                     Visibility="{Binding Detail.HasUsedInReleases,
                         Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                    <ItemsControl ItemsSource="{Binding Detail.UsedInReleases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCard}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                        MouseLeftButtonUp="UsedInRelease_MouseLeftButtonUp"
                                        Tag="{Binding ReleaseId}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Release.ReleaseType.Name, Converter={StaticResource NullToWild}}"
                                                   FontSize="10" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="{Binding Release.Title}"
                                                   Foreground="{DynamicResource TextLink}" FontSize="12"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ── Onglet Media ─────────────────────────────────────────── -->
            <TabItem Header="{DynamicResource RD_Media}">
                <TabControl x:Name="MediaTabs" TabStripPlacement="Top"
                            Background="Transparent" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Border}" Margin="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource FlatTabItem}"/>
                    </TabControl.ItemContainerStyle>

                    <!-- Screenshots -->
                    <TabItem Header="{DynamicResource RD_Screenshots}">
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            Content="{DynamicResource App_Download}"
                                            Command="{Binding DownloadScreenshotsCommand}"
                                            Padding="10,5" FontSize="11">
                                        <Button.Visibility>
                                            <Binding Source="{x:Static app:DebugHelper.IsDebugMode}"
                                                     Converter="{StaticResource BoolToVisibility}"/>
                                        </Button.Visibility>
                                    </Button>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center">
                                        <Run Text="{DynamicResource List_Screenshots}"/>
                                        <Run Text="{Binding Detail.Screenshots.Count, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Detail.Screenshots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="160" Height="110" Margin="0,0,8,8"
                                                    Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}" Cursor="Hand">
                                                <Image Source="{Binding FilePath}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Soundtracks -->
                    <TabItem Header="{DynamicResource RD_Soundtracks}">
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16" MaxHeight="280">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Detail.Soundtracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="12,10" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Width="32" Height="32" Margin="8,0,0,0"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Ajouter aux soundtracks favoris"
                                                            Command="{Binding DataContext.ToggleFavoriteSoundCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding SoundtrackId}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="☆"/>
                                                                    <Setter Property="FontSize" Value="16"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Text" Value="★"/>
                                                                            <Setter Property="Foreground" Value="#F5C518"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="{DynamicResource RD_Play}"
                                                            Style="{StaticResource AccentButton}"
                                                            Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.PlaySoundtrackCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding SoundtrackId}"
                                                            Visibility="{Binding HasPlayableRom,
                                                                Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Soundtrack.Supertype}"
                                                               FontSize="10" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Soundtrack.Title}"
                                                                   Foreground="{DynamicResource TextLink}" FontSize="12"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonUp="SoundtrackTitle_MouseLeftButtonUp"
                                                                   Tag="{Binding SoundtrackId}"/>
                                                        <TextBlock Text="{Binding RomName}"
                                                                   FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource Accent}" Margin="0,1,0,0"
                                                                   Visibility="{Binding HasPlayableRom,
                                                                       Converter={StaticResource BoolToVisibility}}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Soundtrack.AuthorNamesCache}"
                                                                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                                       Visibility="{Binding Soundtrack.AuthorNamesCache,
                                                                           Converter={StaticResource NullToVisibility}}"/>
                                                            <TextBlock Text="{Binding Soundtrack.ReleaseDate}"
                                                                       FontSize="10" Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource RD_NoSoundtrack}"
                                           Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail.Soundtracks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Video Capture -->
                    <TabItem Header="{DynamicResource RD_VideoCapture}">
                        <Grid>
                            <!-- Player intégré (Vimeo, local) -->
                            <Border Visibility="{Binding VideoPlayer,
                                        Converter={StaticResource NullToVisibility}}">
                                <views:VideoPlayerView x:Name="VideoPlayerViewCtrl"
                                                       DataContext="{Binding VideoPlayer}"
                                                       MinHeight="340"/>
                            </Border>
                            <!-- Liens YouTube seuls : boutons ouvrir dans le navigateur -->
                            <Border Visibility="{Binding VideoPlayer,
                                        Converter={StaticResource InverseNullToVisibility}}"
                                    Padding="20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="YouTube" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                    <ItemsControl ItemsSource="{Binding WebVideoLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgCard}"
                                                        BorderBrush="{DynamicResource Border}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="16,10" Margin="0,0,0,8"
                                                        Cursor="Hand">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="🌐" FontSize="16"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextLink}"
                                                                   VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.OpenVideoLinkCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource RD_NoVideo}"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Padding="40,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding VideoPlayer}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding LocalVideos.Count}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TabItem.Visibility>
                            <Binding Path="HasVideos" Converter="{StaticResource BoolToVisibility}"/>
                        </TabItem.Visibility>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ── Onglet Fichiers ──────────────────────────────────────── -->
            <TabItem Header="{DynamicResource RD_Files}">
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                    <StackPanel>

                        <!-- ── Erreur de téléchargement ──────────────────── -->
                        <!-- Fond légèrement teinté de rouge (pas juste BgCard noir) + texte
                             clair (TextPrimary, pas Red/TextMuted trop sombres sur fond
                             sombre) : l'ancienne combinaison rouge-sur-noir était quasi
                             illisible (contraste ~3.9:1, sous le seuil WCAG AA de 4.5:1
                             pour du texte normal). Le rouge reste utilisé pour l'icône et
                             la bordure, suffisant pour signaler "erreur" sans sacrifier la
                             lisibilité du texte. -->
                        <Border BorderBrush="{DynamicResource Red}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding BuildErrorMessage,
                                    Converter={StaticResource NullToVisibility}}">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource RedColor}" Opacity="0.14"/>
                            </Border.Background>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="✗" FontSize="14"
                                           Foreground="{DynamicResource Red}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Téléchargement incomplet"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock behaviors:LinkTextBehavior.AutoLinkText="{Binding BuildErrorMessage}"
                                               FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource RD_NoDAT}"
                                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- DatFilesWithMismatch (pas Detail.DatFiles brut) : une release
                                             qui n'a QUE des entrées "Code Sources" doit voir ce message,
                                             même si Detail.DatFiles.Count > 0. -->
                                        <DataTrigger Binding="{Binding DatFilesWithMismatch.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DatFilesWithMismatch}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,6">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Expander">
                                                            <Border BorderThickness="2"
                                                                    CornerRadius="{StaticResource RadiusMd}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding Entry, Converter={StaticResource DatEntryStatusToColor}}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                                                    </Style>
                                                                </Border.Style>
                                                                <!-- Indicateur "sélectionné pour lancement" -->
                                                                <Border.Resources>
                                                                    <Style TargetType="Border" x:Key="SelectedBorder">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                    </Style>
                                                                </Border.Resources>
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <!-- Bouton Ouvrir -->
                                                                        <Button DockPanel.Dock="Right"
                                                                                Content="{DynamicResource RD_OpenFile}"
                                                                                Style="{StaticResource IconButton}"
                                                                                Padding="10,6" FontSize="11"
                                                                                Margin="4,4,8,4"
                                                                                VerticalAlignment="Center"
                                                                                Command="{Binding DataContext.OpenDatFileCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Entry}"/>
                                                                        <!-- Bouton sélectionner pour lancement -->
                                                                        <Button DockPanel.Dock="Right"
                                                                                Padding="8,4" FontSize="10"
                                                                                Margin="0,4,2,4"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="Sélectionner ce fichier pour le lancement"
                                                                                Command="{Binding DataContext.SelectDatEntryCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Entry}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                                    <Setter Property="Content" Value="{DynamicResource RD_Use}"/>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                                    <Style.Triggers>
                                                                                        <!-- ReferenceEquality = IMultiValueConverter — compare SelectedDatEntry et item courant -->
                                                                                        <DataTrigger Value="True">
                                                                                            <DataTrigger.Binding>
                                                                                                <MultiBinding Converter="{StaticResource ReferenceEquality}">
                                                                                                    <Binding Path="DataContext.SelectedDatEntry"
                                                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                                                    <Binding Path="Entry"/>
                                                                                                </MultiBinding>
                                                                                            </DataTrigger.Binding>
                                                                                            <Setter Property="Content" Value="{DynamicResource RD_Selected}"/>
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                        <ToggleButton IsChecked="{Binding IsExpanded,
                                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                                                                     Style="{StaticResource ExpanderHeaderToggle}"
                                                                                     Padding="12,10"
                                                                                     HorizontalContentAlignment="Stretch">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right"
                                                                                           FontSize="11" Margin="8,0,0,0"
                                                                                           Foreground="{DynamicResource TextMuted}"
                                                                                           Text="{Binding Entry.Roms.Count, StringFormat='{}{0} fichier(s)', Mode=OneWay}"/>
                                                                                <TextBlock DockPanel.Dock="Right"
                                                                                           FontSize="12" Margin="8,0,0,0"
                                                                                           Foreground="{DynamicResource TextMuted}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded,
                                                                                                    RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                                                             Value="True">
                                                                                                    <Setter Property="Text" Value="▲"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                            <Setter Property="Text" Value="▼"/>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           ToolTip="{Binding Entry.RomPath, Converter={StaticResource RomPathToName}}">
                                                                                    <TextBlock.Text>
                                                                                        <Binding Path="Entry.RomPath"
                                                                                                 Converter="{StaticResource RomPathToName}"/>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                            </DockPanel>
                                                                        </ToggleButton>
                                                                    </DockPanel>
                                                                    <ContentPresenter Margin="0"
                                                                        Visibility="{Binding IsExpanded,
                                                                            RelativeSource={RelativeSource TemplatedParent},
                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Expander.Style>
                                        <StackPanel>
                                            <!-- Avertissement si la collection est très grande -->
                                            <Border Background="{DynamicResource BgSurface}"
                                                    CornerRadius="4" Padding="8,5" Margin="12,6,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <!-- Le DataContext ici est un DatEntryWithMismatch (cf. Entry.Roms.Count
                                                                 juste en dessous) — "Roms" seul n'existe pas dessus, d'où l'erreur de
                                                                 binding en continu dans les logs (WPF retombe sur la valeur par défaut,
                                                                 donc aucun effet visuel, mais spam de "System.Windows.Data Error"). -->
                                                            <DataTrigger Binding="{Binding Entry.Roms.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding Entry.Roms.Count, StringFormat='⚠ {0} fichiers — défilement virtualisé'}"/>
                                            </Border>
                                            <!-- Liste virtualisée — seuls les éléments visibles sont rendus -->
                                            <ListBox ItemsSource="{Binding Entry.Roms}"
                                                     MaxHeight="400"
                                                     Margin="12,4,12,10"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="0,0,0,1" Padding="4,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- 2026-07-29, retour utilisateur : "possibile de mettre dans la liste
                                                                     des fichiers celui est correspond au dat ?" — coche verte sur le
                                                                     fichier effectivement trouvé/téléchargé lors de la dernière
                                                                     tentative (ReleaseDetailViewModel.LastBuildFoundRomIds). -->
                                                                <TextBlock Grid.Column="0" Text="✓" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource Green}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="Trouvé lors de la dernière tentative de téléchargement">
                                                                    <TextBlock.Visibility>
                                                                        <MultiBinding Converter="{StaticResource RomFoundToVisibility}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.LastBuildFoundRomIds"
                                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           FontSize="11" FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Crc32}"
                                                                           FontSize="10" FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextMuted}" Margin="8,0"/>
                                                                <TextBlock Grid.Column="3" FontSize="10"
                                                                           FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextMuted}"
                                                                           HorizontalAlignment="Right">
                                                                    <TextBlock.Text>
                                                                        <Binding Path="Size" Converter="{StaticResource FileSizeConverter}"/>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        <!-- ── Mismatch sous ce set ──────── -->
                                        <Border Background="{DynamicResource BgCard}"
                                                BorderBrush="{DynamicResource Red}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="12,0,12,8"
                                                Visibility="{Binding HasMismatch,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Red}">
                                                    <Run Text="⚠ Taille incompatible avec le DAT :"/>
                                                    <Run Text="{Binding Mismatch.FileName, Mode=OneWay}"
                                                         FontFamily="{StaticResource FontMono}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,2,0,0">
                                                    <Run Text="Serveur :"/>
                                                    <Run Text="{Binding Mismatch.SizeOnServer, StringFormat='{}{0:N0} o', Mode=OneWay}"
                                                         Foreground="{DynamicResource Red}"/>
                                                    <Run Text="  DAT :"/>
                                                    <Run Text="{Binding Mismatch.SizeInDat, StringFormat='{}{0:N0} o', Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Mismatch.AttemptedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── Fichiers avec taille incompatible (DAT désynchronisé) ── -->
                        <Border Margin="0,16,0,0"
                                Visibility="{Binding HasDownloadMismatches, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="✕ Réessayer"
                                            Style="{StaticResource IconButton}"
                                            Padding="8,4" FontSize="11"
                                            Command="{Binding ClearDownloadMismatchesCommand}"
                                            ToolTip="Supprime les entrées pour forcer un nouveau téléchargement"/>
                                    <TextBlock Text="⚠ Fichiers incompatibles avec le DAT"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Ces fichiers ont été téléchargés mais leur taille ne correspond pas au DAT. Le DAT est peut-être désynchronisé."
                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding DownloadMismatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource Accent}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="10,8" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   FontFamily="{StaticResource FontMono}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                                   Margin="0,2,0,0">
                                                            <Run Text="Serveur :"/>
                                                            <Run Text="{Binding SizeOnServer, StringFormat='{}{0:N0} o', Mode=OneWay}"
                                                                 Foreground="{DynamicResource Red}"/>
                                                            <Run Text="  DAT :"/>
                                                            <Run Text="{Binding SizeInDat, StringFormat='{}{0:N0} o', Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextSecondary}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Url}"
                                                                   FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AttemptedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                               FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Top" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Onglet Code Sources — visible seulement si des DatEntry ont un
                 SourceFile contenant "Sources Code" (voir LoadDownloadMismatchesAsync) ── -->
            <TabItem Header="{DynamicResource RD_CodeSources}"
                     Visibility="{Binding HasCodeSourcesFiles,
                         Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="20,16">
                    <StackPanel>

                        <TextBlock Text="{DynamicResource RD_NoCodeSources}"
                                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CodeSourcesWithMismatch.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Même structure (Expander/ListBox/mismatch) que l'onglet Fichiers,
                             juste rebranchée sur CodeSourcesWithMismatch au lieu de
                             DatFilesWithMismatch. -->
                        <ItemsControl ItemsSource="{Binding CodeSourcesWithMismatch}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,6">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Expander">
                                                            <Border BorderThickness="2"
                                                                    CornerRadius="{StaticResource RadiusMd}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding Entry, Converter={StaticResource DatEntryStatusToColor}}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.Resources>
                                                                    <Style TargetType="Border" x:Key="SelectedBorder">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                    </Style>
                                                                </Border.Resources>
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <!-- Bouton Ouvrir -->
                                                                        <Button DockPanel.Dock="Right"
                                                                                Content="{DynamicResource RD_OpenFile}"
                                                                                Style="{StaticResource IconButton}"
                                                                                Padding="10,6" FontSize="11"
                                                                                Margin="4,4,8,4"
                                                                                VerticalAlignment="Center"
                                                                                Command="{Binding DataContext.OpenDatFileCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Entry}"/>
                                                                        <!-- Pas de bouton "Sélectionner pour lancement" ici : les entrées
                                                                             Code Sources sont exclues du lancement (voir
                                                                             DatEntry.IsCodeSourceEntry) — contrairement à l'onglet
                                                                             Fichiers, il n'y a rien à "utiliser" pour jouer/lancer. -->
                                                                        <ToggleButton IsChecked="{Binding IsExpanded,
                                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                                                                     Style="{StaticResource ExpanderHeaderToggle}"
                                                                                     Padding="12,10"
                                                                                     HorizontalContentAlignment="Stretch">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right"
                                                                                           FontSize="11" Margin="8,0,0,0"
                                                                                           Foreground="{DynamicResource TextMuted}"
                                                                                           Text="{Binding Entry.Roms.Count, StringFormat='{}{0} fichier(s)', Mode=OneWay}"/>
                                                                                <TextBlock DockPanel.Dock="Right"
                                                                                           FontSize="12" Margin="8,0,0,0"
                                                                                           Foreground="{DynamicResource TextMuted}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsExpanded,
                                                                                                    RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                                                             Value="True">
                                                                                                    <Setter Property="Text" Value="▲"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                            <Setter Property="Text" Value="▼"/>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           ToolTip="{Binding Entry.RomPath, Converter={StaticResource RomPathToName}}">
                                                                                    <TextBlock.Text>
                                                                                        <Binding Path="Entry.RomPath"
                                                                                                 Converter="{StaticResource RomPathToName}"/>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                            </DockPanel>
                                                                        </ToggleButton>
                                                                    </DockPanel>
                                                                    <ContentPresenter Margin="0"
                                                                        Visibility="{Binding IsExpanded,
                                                                            RelativeSource={RelativeSource TemplatedParent},
                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Expander.Style>
                                        <StackPanel>
                                            <Border Background="{DynamicResource BgSurface}"
                                                    CornerRadius="4" Padding="8,5" Margin="12,6,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Entry.Roms.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Text="{Binding Entry.Roms.Count, StringFormat='⚠ {0} fichiers — défilement virtualisé'}"/>
                                            </Border>
                                            <ListBox ItemsSource="{Binding Entry.Roms}"
                                                     MaxHeight="400"
                                                     Margin="12,4,12,10"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Item"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="0,0,0,1" Padding="4,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- 2026-07-29, retour utilisateur : "possibile de mettre dans la liste
                                                                     des fichiers celui est correspond au dat ?" — coche verte sur le
                                                                     fichier effectivement trouvé/téléchargé lors de la dernière
                                                                     tentative (ReleaseDetailViewModel.LastBuildFoundRomIds). -->
                                                                <TextBlock Grid.Column="0" Text="✓" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource Green}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="Trouvé lors de la dernière tentative de téléchargement">
                                                                    <TextBlock.Visibility>
                                                                        <MultiBinding Converter="{StaticResource RomFoundToVisibility}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.LastBuildFoundRomIds"
                                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           FontSize="11" FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Crc32}"
                                                                           FontSize="10" FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextMuted}" Margin="8,0"/>
                                                                <TextBlock Grid.Column="3" FontSize="10"
                                                                           FontFamily="{StaticResource FontMono}"
                                                                           Foreground="{DynamicResource TextMuted}"
                                                                           HorizontalAlignment="Right">
                                                                    <TextBlock.Text>
                                                                        <Binding Path="Size" Converter="{StaticResource FileSizeConverter}"/>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        <!-- ── Mismatch sous ce set ──────── -->
                                        <Border Background="{DynamicResource BgCard}"
                                                BorderBrush="{DynamicResource Red}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,8" Margin="12,0,12,8"
                                                Visibility="{Binding HasMismatch,
                                                    Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Red}">
                                                    <Run Text="⚠ Taille incompatible avec le DAT :"/>
                                                    <Run Text="{Binding Mismatch.FileName, Mode=OneWay}"
                                                         FontFamily="{StaticResource FontMono}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,2,0,0">
                                                    <Run Text="Serveur :"/>
                                                    <Run Text="{Binding Mismatch.SizeOnServer, StringFormat='{}{0:N0} o', Mode=OneWay}"
                                                         Foreground="{DynamicResource Red}"/>
                                                    <Run Text="  DAT :"/>
                                                    <Run Text="{Binding Mismatch.SizeInDat, StringFormat='{}{0:N0} o', Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Mismatch.AttemptedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ── Zone visu : TrackerPlayer / GraphicsViewer / (vide si production) -->
        <!-- Pas de DockPanel.Dock ici : dernier enfant du DockPanel racine →
             rempli automatiquement par LastChildFill, donc s'étire pour occuper
             tout l'espace vertical restant sous les onglets, quelle que soit la
             hauteur de la fenêtre. -->
        <Grid>
            <!-- TrackerPlayer — releases Music OU tout type de release ayant
                 un soundtrack en cours de lecture (ex: morceau lancé depuis
                 l'onglet Media/Soundtracks d'une Demo, qui n'a pas
                 Supertype="music" mais doit quand même afficher le lecteur). -->
            <Border MinHeight="320"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowSoundtrackArea, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Border Visibility="{Binding SoundtrackPlayer,
                                Converter={StaticResource NullToVisibility}}">
                        <ContentControl Content="{Binding SoundtrackPlayer}"/>
                    </Border>
                    <TextBlock Text="{DynamicResource RD_ClickPlay}"
                               FontSize="13" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SoundtrackPlayer,
                                   Converter={StaticResource InverseNullToVisibility}}"/>
                </Grid>
            </Border>

            <!-- GraphicsViewer — releases Graphics : visible seulement quand le viewer est actif -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding GraphicsViewer, Converter={StaticResource NullToVisibility}}">
                <!-- Instanciation directe sans DataTemplate → pas de liste de fichiers parasite,
                     toute la largeur disponible pour l'image -->
                <ContentControl Content="{Binding GraphicsViewer}"/>
            </Border>

            <!-- CodeSourceViewer — visible dès qu'une release a au moins un DatEntry
                 "Sources Code" (voir ShowCodeSourceAsync/HasCodeSourcesFiles), SAUF si
                 TrackerPlayer ou GraphicsViewer occupe déjà cette zone partagée (voir
                 ShowCodeSourceArea — une release Music/Graphics peut aussi avoir des
                 sources, mais son contenu principal reste prioritaire dans cette zone). -->
            <Border MinHeight="320"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowCodeSourceArea, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{Binding CodeSourceViewer}"/>
            </Border>

            <!-- VideoPlayer inline — releases de type "Vidéo" uniquement.
                 N'apparaît que quand l'utilisateur clique "Play Video" (InlineVideoPlayer
                 est null jusqu'alors). Distinct du VideoPlayer de l'onglet Media qui gère
                 les captures locales et les liens YouTube/Vimeo. -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding InlineVideoPlayer, Converter={StaticResource NullToVisibility}}">
                <views:VideoPlayerView DataContext="{Binding InlineVideoPlayer}" MinHeight="340"/>
            </Border>

        </Grid>
    </DockPanel>

        <!-- ── Overlay "Téléchargement en cours…" ─────────────────────────────
             Affiché pendant la reconstruction automatique d'une release dont le
             ZIP n'est pas trouvé localement (cf. ReleaseBuilderService), ou pendant un
             téléchargement ad-hoc (release pas encore couverte par un DAT).
             2026-07-27, retour utilisateur : une MessageBox système s'affichait par-dessus
             cet overlay en cas d'échec réseau (ex. connexion refusée) — demande explicite de
             l'afficher DANS l'overlay avec un bouton OK. L'overlay reste donc visible même
             après la fin du téléchargement tant que BuildErrorMessage n'a pas été vidé (cf.
             LaunchAsync/ResolveAdHocMediaFileAsync côté ViewModel — leur "finally" ne remet
             plus IsBuildingRelease à false si une erreur doit rester affichée). -->
        <Border Background="#CC000000"
                Visibility="{Binding IsBuildingRelease, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360" MaxWidth="480">
                <StackPanel>
                    <!-- État normal : progression -->
                    <StackPanel Visibility="{Binding BuildErrorMessage, Converter={StaticResource InverseNullToVisibility}}">
                        <TextBlock Text="⬇ Téléchargement en cours…" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding BuildStatusMessage}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <ProgressBar Value="{Binding BuildStatusPercent, Mode=OneWay}"
                                     Maximum="100" Height="6"/>
                    </StackPanel>

                    <!-- État erreur : message + bouton OK, remplace la MessageBox système -->
                    <StackPanel Visibility="{Binding BuildErrorMessage, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="✗ Échec du téléchargement" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Red}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock behaviors:LinkTextBehavior.AutoLinkText="{Binding BuildErrorMessage}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>
                        <Button Content="OK" Command="{Binding DismissBuildErrorCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Center" Padding="28,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>