<UserControl x:Class="DemoBase.App.Views.Releases.ReleaseEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgApp}">

    <DockPanel>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Content="{DynamicResource App_Cancel}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Style="{StaticResource AccentButton}"
                            Content="{DynamicResource RD_SaveEdit}" Padding="14,6"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsSaving,
                                    Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource BgHover}"
                                     BorderThickness="0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource RE_Saving}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Bandeau erreur ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Padding="16,10" Background="#1AE05050"
                BorderBrush="{DynamicResource Red}" BorderThickness="0,0,0,2"
                Visibility="{Binding ErrorMessage,
                    Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource Red}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- ── Formulaire ─────────────────────────────────────────────── -->
        <ScrollViewer Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,24,28,32" MaxWidth="900">

                <!-- Rangée 1 : Titre (pleine largeur) -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource RE_Title}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             FontSize="15" Padding="10,8"/>
                </StackPanel>

                <!-- Rangée 2 : Supertype + Type + Date -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Catégorie -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource RE_Category}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Supertypes}"
                                  SelectedItem="{Binding Supertype}"
                                  Style="{StaticResource FlatComboBox}"/>
                    </StackPanel>

                    <!-- Type de release -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource RE_ReleaseType}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ReleaseTypes}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ReleaseTypeId}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FlatComboBox}"/>
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource RE_Date}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ReleaseDate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" Padding="10,7"/>
                        <TextBlock Text="{DynamicResource RE_DateHint}"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   Margin="2,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Rangée 3 : Notes + Liens côte à côte -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Notes -->
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="{DynamicResource RD_Notes}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding IsFavorite}"
                                          Style="{StaticResource FilterChip}"
                                          Content="{DynamicResource RD_Favorite}" Padding="8,3" FontSize="11"/>
                        </DockPanel>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="130" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                    </StackPanel>

                    <!-- Liens externes -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RD_ExternalLinks}"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,10"/>

                            <!-- Demozoo -->
                            <StackPanel Margin="0,0,0,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Demozoo" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource LinkButton}"
                                            Content="{DynamicResource App_Open}" FontSize="11"
                                            x:Name="BtnOpenDemozoo"
                                            Click="BtnOpenDemozoo_Click"
                                            Visibility="{Binding DemozooUrl,
                                                Converter={StaticResource NullToVisibility}}"/>
                                </DockPanel>
                                <TextBox Text="{Binding DemozooUrl,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchBox}"
                                         FontSize="11" Padding="8,6"/>
                            </StackPanel>

                            <!-- Pouet -->
                            <StackPanel Margin="0,0,0,10">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Pouët" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource LinkButton}"
                                            Content="{DynamicResource App_Open}" FontSize="11"
                                            x:Name="BtnOpenPouet"
                                            Click="BtnOpenPouet_Click"
                                            Visibility="{Binding PouetUrl,
                                                Converter={StaticResource NullToVisibility}}"/>
                                </DockPanel>
                                <TextBox Text="{Binding PouetUrl,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchBox}"
                                         FontSize="11" Padding="8,6"/>
                            </StackPanel>

                            <!-- CSDb -->
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="CSDb" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource LinkButton}"
                                            Content="{DynamicResource App_Open}" FontSize="11"
                                            x:Name="BtnOpenCsdb"
                                            Click="BtnOpenCsdb_Click"
                                            Visibility="{Binding CsdbUrl,
                                                Converter={StaticResource NullToVisibility}}"/>
                                </DockPanel>
                                <TextBox Text="{Binding CsdbUrl,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchBox}"
                                         FontSize="11" Padding="8,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Rangée 4 : Tags + Note personnelle -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tags -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource RD_Tags}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" Padding="10,7"/>
                        <TextBlock Text="{DynamicResource RD_TagsHint}"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   Margin="2,3,0,0"/>
                    </StackPanel>

                    <!-- Note personnelle -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RD_PersonalNote}"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,10"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Rating,
                                               TargetNullValue='—',
                                               StringFormat={}{0}/10}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Gold}"
                                           VerticalAlignment="Center"
                                           MinWidth="40" TextAlignment="Right"/>
                                <Slider Minimum="0" Maximum="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding Rating, TargetNullValue=0}"
                                        Foreground="{DynamicResource Accent}"
                                        Margin="0,0,12,0"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource RE_RatingHint}"
                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
