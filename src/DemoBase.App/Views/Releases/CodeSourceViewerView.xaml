<UserControl x:Class="DemoBase.App.Views.Releases.CodeSourceViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels">

    <!-- Même structure générale que GraphicsViewerView : colonne gauche fixe (220px) /
         séparateur / contenu à droite, mais TreeView (arborescence, façon explorateur
         Windows) au lieu d'une ListBox plate — demande utilisateur explicite pour garder la
         structure de dossiers du ZIP "Code Sources", contrairement au ZIP d'images. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Colonne gauche : arborescence ── -->
        <Grid Grid.Column="0" Background="{DynamicResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <TextBlock FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="{DynamicResource RD_CodeSources}"/>
            </Border>

            <TreeView Grid.Row="1" x:Name="Tree"
                      ItemsSource="{Binding RootNodes}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Padding" Value="2,3"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CodeSourceTreeNode}"
                                               ItemsSource="{Binding Children}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding SizeLabel}"
                                       FontSize="9" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="12"/>
                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- ── Séparateur ── -->
        <Border Grid.Column="1" Background="{DynamicResource Border}"/>

        <!-- ── Colonne droite : aperçu texte colorisé ── -->
        <Grid Grid.Column="2" Background="{DynamicResource BgApp}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre nom de fichier -->
            <Border Grid.Row="0" Padding="12,8"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Visibility="{Binding CurrentFileName, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Text="{Binding CurrentFileName}"
                           FontSize="11" FontFamily="{StaticResource FontMono}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid Grid.Row="1">
                <!-- Spinner chargement -->
                <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource BgHover}"
                             BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Message statut (binaire, erreur, archive vide…) -->
                <Border Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Aperçu texte (RichTextBox rempli en code-behind — voir CodeSourceViewerView.xaml.cs,
                     coloration via SimpleCodeHighlighter.Build) -->
                <RichTextBox x:Name="Preview"
                             IsReadOnly="True"
                             IsDocumentEnabled="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="12,10">
                    <RichTextBox.Style>
                        <Style TargetType="RichTextBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding StatusMessage}" Value=""/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RichTextBox.Style>
                </RichTextBox>

                <!-- Placeholder si rien de sélectionné -->
                <TextBlock Text="Sélectionnez un fichier"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentFileName}" Value=""/>
                                        <Condition Binding="{Binding StatusMessage}" Value=""/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
