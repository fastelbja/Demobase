<UserControl x:Class="DemoBase.App.Views.Releases.GraphicsViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:conv="clr-namespace:DemoBase.App.Converters">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Colonne gauche : liste des fichiers ── -->
        <Grid Grid.Column="0" Background="{DynamicResource BgPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="12,10"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <TextBlock FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}">
                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>
                    <Run Text="fichier(s)"/>
                </TextBlock>
            </Border>

            <!-- Liste -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="10,8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"   Value="{DynamicResource BgSelected}"/>
                                            <Setter Property="BorderBrush"  Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ImageEntryDto}">
                        <StackPanel>
                            <DockPanel>
                                <!-- Badge extension -->
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource BgHover}"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="4,1" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Extension}"
                                               FontSize="9" FontFamily="{StaticResource FontMono}"
                                               Foreground="{DynamicResource Accent}"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SizeLabel}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ── Séparateur ── -->
        <Border Grid.Column="1" Background="{DynamicResource Border}"/>

        <!-- ── Colonne droite : affichage image ── -->
        <Grid Grid.Column="2" Background="{DynamicResource BgApp}">

            <!-- Spinner chargement -->
            <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource BgHover}"
                         BorderThickness="0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Message statut (format non supporté, erreur…) -->
            <Border Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Image + bouton real size -->
            <Grid Visibility="{Binding CurrentImage, Converter={StaticResource NullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       x:Name="PreviewImage"
                       Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="8"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Barre basse : infos + bouton real size -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                Content="⤢ Real size"
                                Padding="10,5"
                                Click="BtnRealSize_Click"/>
                        <!-- Bouton pause/play (GIF animé) -->
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                Padding="8,5" Margin="0,0,6,0"
                                Command="{Binding ToggleAnimationCommand}"
                                Visibility="{Binding IsAnimating, Converter={StaticResource BoolToVisibility}}">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⏸"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AnimPaused}" Value="True">
                                                    <Setter Property="Text" Value="▶"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <!-- Compteur de frames (GIF animé) -->
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Accent}"
                                   Text="{Binding AnimLabel}"
                                   Visibility="{Binding IsAnimating, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- Dimensions -->
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="{Binding CurrentImage.PixelWidth, Mode=OneWay}"/>
                            <Run Text="×"/>
                            <Run Text="{Binding CurrentImage.PixelHeight, Mode=OneWay}"/>
                            <Run Text=" px"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Placeholder si aucune image sélectionnée -->
            <TextBlock Text="Sélectionnez un fichier"
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentImage}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding StatusMessage}" Value=""/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
