<Window x:Class="DemoBase.App.Views.Releases.ExternalDownloadConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dlg_ExtDownload_Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}">

    <!-- 2026-07-25 : confirmation affichée au clic sur "Lancer" quand une release n'a
         encore AUCUN fichier DAT mais possède un lien de téléchargement direct marqué
         IsMainFile par Demozoo — cf. ReleaseDetailViewModel.LaunchAsync /
         ExternalDownloadConfirmWindow.xaml.cs. Remplace l'ancienne MessageBox.Show
         (fenêtre système blanche, hors charte, non traduite) par une fenêtre au même
         style que PlatformPickerWindow/FilePickerWindow/SimpleInfoDialog, entièrement
         traduite via les clés Dlg_ExtDownload_* (Strings.fr.xaml/Strings.en.xaml). -->
    <StackPanel Margin="24">

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠" FontSize="20" Foreground="{DynamicResource Red}"
                       VerticalAlignment="Top" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Dlg_ExtDownload_Heading}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Dlg_ExtDownload_Body}"
                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap" Margin="0,10,0,14"/>

        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="10,8">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{DynamicResource Dlg_ExtDownload_FilePrefix}" Foreground="{DynamicResource TextMuted}"/>
                    <Run Text="{Binding FileLabel, Mode=OneWay}" FontFamily="{StaticResource FontMono}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{DynamicResource Dlg_ExtDownload_HostPrefix}" Foreground="{DynamicResource TextMuted}"/>
                    <Run Text="{Binding HostLabel, Mode=OneWay}" FontFamily="{StaticResource FontMono}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource Dlg_ExtDownload_Warning}"
                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap" Margin="0,14,0,0"/>

        <CheckBox Content="{DynamicResource Dlg_DontShowAgain}"
                  IsChecked="{Binding DontAskAgain}"
                  FontSize="12" Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource Dlg_Cancel}" FontSize="12" Padding="14,7" Margin="0,0,8,0"
                    Style="{StaticResource IconButton}"
                    Click="Cancel_Click"/>
            <Button Content="{DynamicResource Dlg_Download}" FontSize="12" Padding="18,7"
                    Style="{StaticResource AccentButton}"
                    Click="Confirm_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
