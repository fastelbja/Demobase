<UserControl x:Class="DemoBase.App.Views.WizardPages.ReadyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center">

        <TextBlock Text="🎉" FontSize="48" Margin="0,0,0,20"/>

        <TextBlock Text="{DynamicResource Wiz_ReadyTitle}" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,8"/>

        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,24" TextWrapping="Wrap">
            The initial DemoBase setup is complete.
        </TextBlock>

        <!-- State: seeding in progress -->
        <StackPanel Visibility="{Binding IsSeeding, Converter={StaticResource BoolToVis}}"
                    Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Wiz_ReadySeeding}" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- State: seed summary -->
        <Border Visibility="{Binding SeedDone, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding SeedSummary}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="10" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap">
                    Each emulator always keeps the same internal identifier,
                    whether it's installed or not — you can configure missing
                    paths at any time from Preferences.
                </TextBlock>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
