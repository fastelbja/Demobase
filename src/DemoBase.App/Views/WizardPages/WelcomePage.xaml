<UserControl x:Class="DemoBase.App.Views.WizardPages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">

        <!-- Sélecteur de langue ─────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
            <TextBlock Text="Language / Langue"
                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="FR" Width="38" Height="26" FontSize="12" FontWeight="SemiBold"
                    Margin="0,0,6,0"
                    Style="{StaticResource AccentButton}"
                    Click="OnSelectFr"/>
            <Button Content="EN" Width="38" Height="26" FontSize="12" FontWeight="SemiBold"
                    Style="{StaticResource IconButton}"
                    Click="OnSelectEn"/>
        </StackPanel>

        <TextBlock Text="{DynamicResource Wiz_WelcomeTag}"
                   FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource Accent}"
                   Margin="0,0,0,24"/>

        <TextBlock FontSize="32" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,8">
            <Run Text="{DynamicResource Wiz_WelcomeTitle}"/>
            <LineBreak/>
            <Run Text="DemoBase" Foreground="{DynamicResource Accent}"/>
        </TextBlock>

        <TextBlock FontSize="14"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,28"
                   Text="{DynamicResource Wiz_WelcomeSubtitle}"/>

        <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="0,0,0,28"/>

        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,16"
                   Text="{DynamicResource Wiz_WelcomeBody}"/>

        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="22"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,32"
                   Text="{DynamicResource Wiz_WelcomeBody2}"/>

        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="💡" FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Wiz_WelcomeTip}"/>
            </DockPanel>
        </Border>

    </StackPanel>
</UserControl>
