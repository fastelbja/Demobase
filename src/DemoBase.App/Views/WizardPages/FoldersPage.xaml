<UserControl x:Class="DemoBase.App.Views.WizardPages.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <TextBlock Text="{DynamicResource Wiz_FoldersTitle}" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,24" TextWrapping="Wrap"
                   Text="{DynamicResource Wiz_FoldersSubtitle}"/>

        <ItemsControl x:Name="DirsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="{Binding Label}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <TextBox  Grid.Column="1" Grid.Row="0"
                                  Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SearchBox}"
                                  FontFamily="{StaticResource FontMono}"
                                  FontSize="11"
                                  Padding="8,6"
                                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" Grid.Row="0"
                                Content="…" Margin="6,0,0,0"
                                Padding="10,6"
                                Style="{StaticResource IconButton}"
                                Command="{Binding BrowseCommand}"
                                ToolTip="{DynamicResource Wiz_FoldersBrowse}"/>

                        <TextBlock Grid.Column="1" Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   FontSize="10" Margin="2,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6"
                Padding="14,10" Margin="0,8,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}">
                <Run Text="{DynamicResource Wiz_FoldersTip}"/>
                <Run Text=" "/>
                <Run Text="{DynamicResource Wiz_FoldersPrefs}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}"/>
                <Run Text="."/>
            </TextBlock>
        </Border>

    </StackPanel>
</UserControl>
