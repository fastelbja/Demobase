<UserControl x:Class="DemoBase.App.Views.WizardPages.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center">

        <!-- Titre -->
        <TextBlock Text="{DynamicResource Wiz_DatabaseTitle}" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,0,0,24" TextWrapping="Wrap"
                   Text="{DynamicResource Wiz_DatabaseBody}"/>

        <!-- État : pas encore importé -->
        <StackPanel Visibility="{Binding NotStarted, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="20,18" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🗄" FontSize="28"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Wiz_DatabaseNone}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Wiz_DatabaseNoneDesc}"
                                   FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Content="{DynamicResource Wiz_DatabaseBtn}"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Left"
                    Padding="16,9"
                    Command="{Binding StartImportCommand}"/>
        </StackPanel>

        <!-- État : import en cours ─────────────────────────────────────── -->
        <StackPanel Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">

            <!-- Phase 1 : Téléchargement -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadPercentText}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="{DynamicResource Wiz_DatabaseDownload}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>
            <ProgressBar Value="{Binding DownloadPercent, Mode=OneWay}"
                         Maximum="100" Height="6" Margin="0,0,0,4">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="IsIndeterminate" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DownloadIndeterminate}" Value="True">
                                <Setter Property="IsIndeterminate" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding DownloadDetail}"
                       FontSize="10" Margin="0,0,0,18"
                       Foreground="{DynamicResource TextMuted}"/>

            <!-- Phase 2 : Import -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ImportPercentText}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="{DynamicResource Wiz_DatabaseImport}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImportStarted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <ProgressBar Value="{Binding ImportPercent, Mode=OneWay}"
                         Maximum="100" Height="6" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ImportDetail}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMuted}"/>
        </StackPanel>

        <!-- État : terminé -->
        <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Green}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="20,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="✓" FontSize="28"
                               Foreground="{DynamicResource Green}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Wiz_DatabaseDone}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding DoneSummary}"
                                   FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- État : erreur -->
        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Red}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="20,18" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="✗" FontSize="28"
                               Foreground="{DynamicResource Red}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Wiz_DatabaseFailed}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Button Content="↻ Retry"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Left"
                    Padding="16,9"
                    Command="{Binding StartImportCommand}"/>
        </StackPanel>

        <!-- Note : import obligatoire -->
        <TextBlock Visibility="{Binding NotStarted, Converter={StaticResource BoolToVis}}"
                    FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"
                    Foreground="{DynamicResource TextMuted}"
                    Text="{DynamicResource Wiz_DatabaseMandatory}"/>

    </StackPanel>
</UserControl>
