<UserControl x:Class="DemoBase.App.Views.WizardPages.BiosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <TextBlock Text="{DynamicResource Wiz_BiosTitle}" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,24"
                   Text="{DynamicResource Wiz_BiosSubtitle}"/>

        <Border Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}" Padding="20,16">
            <StackPanel>

                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource AccentButton}" Padding="14,7"
                            VerticalAlignment="Center"
                            Command="{Binding DownloadBiosPackCommand}"
                            IsEnabled="{Binding IsBiosDownloading,
                                Converter={StaticResource InverseBool}}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Pref_BiosPackButton}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBiosAlreadyInstalled}" Value="True">
                                                <Setter Property="Text" Value="⟳ Mettre à jour"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Pref_BiosPackTitle}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Pref_BiosPackDesc}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" MaxWidth="420"/>
                    </StackPanel>
                </DockPanel>

                <!-- Progression -->
                <StackPanel Visibility="{Binding IsBiosDownloading,
                                Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding BiosDownloadPercent, StringFormat={}{0} %}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding BiosDownloadLabel}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding BiosDownloadPercent}"
                                 Minimum="0" Maximum="100"
                                 Height="6" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Statut -->
                <TextBlock Text="{Binding BiosStatusMessage}"
                           FontSize="11" Foreground="{DynamicResource Accent}"
                           TextWrapping="Wrap"
                           Visibility="{Binding BiosStatusMessage,
                               Converter={StaticResource NullToVisibility}}"/>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
