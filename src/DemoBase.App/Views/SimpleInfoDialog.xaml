<Window x:Class="DemoBase.App.Views.SimpleInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="480" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgApp}">

    <!-- 2026-07-25 : fenêtre d'information générique (titre/heading/corps/bouton "Compris"),
         même style que HatariInfoDialog/WinUAEInfoDialog/DosBoxXInfoDialog mais réutilisable
         pour n'importe quel message — remplace les MessageBox.Show natives (hors charte
         graphique, non traduites) restées dans Services.cs pour les erreurs de lancement
         (émulateur non configuré, fichier introuvable). Les 3 textes sont résolus via
         LocalizationService.Get(clé) au moment de la construction — cf.
         SimpleInfoDialog.xaml.cs. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DemoBase.App;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚠" FontSize="18" Foreground="{DynamicResource Red}"
                       VerticalAlignment="Top" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Heading}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="{Binding Body}"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

        <Button Content="{DynamicResource Dlg_Understood}" Click="Ok_Click"
                HorizontalAlignment="Right"
                Padding="24,8" FontSize="12"
                Style="{StaticResource AccentButton}"
                IsDefault="True"/>
    </StackPanel>
</Window>
