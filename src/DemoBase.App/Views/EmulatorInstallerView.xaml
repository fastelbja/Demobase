<UserControl x:Class="DemoBase.App.Views.EmulatorInstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:app="clr-namespace:DemoBase.App">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Phase sélection (wizard uniquement) ────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2"
                Padding="20,12"
                Visibility="{Binding IsSelectionPhase, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Wiz_EmuSelectNone}" Style="{StaticResource IconButton}"
                            Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding SelectNoneCommand}"/>
                    <Button Content="{DynamicResource Wiz_EmuSelectAll}" Style="{StaticResource IconButton}"
                            Padding="10,6" Margin="0,0,8,0"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Command="{Binding ConfirmSelectionCommand}"
                            Style="{StaticResource AccentButton}" Padding="14,6">
                        <Button.Content>
                            <TextBlock>
                                <Run Text="{DynamicResource Wiz_EmuInstallBtn}"/>
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Wiz_EmuSelectTitle}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Wiz_EmuSelectDesc}"
                               FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- En-tête ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="20,14"
                Visibility="{Binding IsWizardMode, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="📄 Error log"
                        Command="{Binding OpenLogFileCommand}"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"
                        Padding="10,6"/>

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="🔄 Check for updates"
                        Command="{Binding CheckUpdatesCommand}"
                        Padding="10,6" Margin="0,0,8,0"
                        Visibility="{Binding IsWizardMode, Converter={StaticResource InverseBoolToVisibility}}"/>

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource AccentButton}"
                        Content="⬇ Install / update all"
                        Command="{Binding InstallAllCommand}"
                        Padding="10,6" Margin="0,0,8,0"/>

                <!-- Bouton export configs — mode debug uniquement -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="📤 Export configs"
                        Command="{Binding ExportConfigsCommand}"
                        Padding="10,6" Margin="0,0,8,0"
                        ToolTip="Exporter toutes les configs et settings émulateurs en JSON (bureau)"
                        Visibility="{Binding Source={x:Static app:DebugHelper.IsDebugMode},
                            Converter={StaticResource BoolToVisibility}}"/>

                <!-- Bouton export sélections de profil par release — mode debug uniquement -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="📤 Export profils releases"
                        Command="{Binding ExportProfileOverridesCommand}"
                        Padding="10,6" Margin="0,0,8,0"
                        ToolTip="Exporter les sélections de profil par release en JSON (bureau) — portable entre installations (ReleaseDemozooId + EmulatorConfigId, identifiants stables)"
                        Visibility="{Binding Source={x:Static app:DebugHelper.IsDebugMode},
                            Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel>
                    <TextBlock Text="Installing emulators"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Margin="0,2,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding GlobalStatus, Mode=OneWay}"/>
                        <Run Text=" — Target folder: "/>
                        <Run Text="{Binding EmusRootDisplay, Mode=OneWay}"
                             FontFamily="{StaticResource FontMono}" FontSize="10"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Liste compacte en lignes (table-like) — une ligne par émulateur -->
        <ScrollViewer x:Name="ListScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,8">

                <!-- En-têtes de colonnes -->
                <Grid Margin="6,2,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Wiz_EmuColName}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Wiz_EmuColVersion}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="3" Text="{DynamicResource Wiz_EmuColStatus}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                </Grid>

                <ItemsControl x:Name="EmulatorsList" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EmulatorInstallItemViewModel}">
                            <!-- Une ligne = 1 émulateur, une seule ligne de texte -->
                            <Border Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,0,0,3" Padding="10,5"
                                    MinHeight="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox sélection (visible en phase de sélection wizard) -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelectedForInstall}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Visibility="{Binding DataContext.IsSelectionPhase,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                  Converter={StaticResource BoolToVis}}"/>

                                    <!-- Nom + systèmes -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Orientation="Vertical" Margin="0,1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Systems}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Systems,
                                                       Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>

                                    <!-- Version installée / récupérée -->
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding InstalledVersion}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Statut texte (la progression se voit dans la barre
                                         globale entre Annuler/Précédent, pas ici — pas la
                                         place pour une barre par ligne) -->
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                                               Text="{Binding StatusMessage}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Bouton ⓘ détails d'erreur — visible seulement en échec -->
                                    <Button Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Width="22" Height="22" Padding="0"
                                            Content="ⓘ" FontSize="12"
                                            Style="{StaticResource IconButton}"
                                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ShowErrorDetailsCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Wiz_EmuErrorDetails}"/>

                                    <!-- Bouton "Réessayer" — visible UNIQUEMENT en cas d'échec.
                                         L'installation se déclenche automatiquement (page
                                         Émulateurs), donc pas besoin d'un bouton "Installer"
                                         permanent — il laisse plus de place pour le statut. -->
                                    <Button Grid.Column="5"
                                            VerticalAlignment="Center"
                                            Padding="8,4" FontSize="11"
                                            Content="{DynamicResource Wiz_EmuRetry}"
                                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.InstallCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Check mark de succès -->
                                    <TextBlock Grid.Column="6"
                                               Text="✓" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Green}"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Barre de progression globale (vérification initiale) ─────────── -->
        <ProgressBar Grid.Row="3"
                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"
                     IsIndeterminate="True" Height="3"/>
    </Grid>
</UserControl>
