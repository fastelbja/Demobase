<UserControl x:Class="DemoBase.App.Views.FavoriteGraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
             xmlns:models="clr-namespace:DemoBase.Core.Models;assembly=DemoBase.Core"
             xmlns:vrel="clr-namespace:DemoBase.App.Views.Releases"
             Background="{DynamicResource BgApp}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Contenu -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Background="{DynamicResource BgCard}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Nav_FavGraphics}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                    <Run Text="{Binding Graphics.Count, Mode=OneWay}"/>
                    <Run Text="{DynamicResource Count_Graphics}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Contenu : Liste gauche + Viewer droite ─────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Liste des favoris ── -->
            <Grid Grid.Column="0" Background="{DynamicResource BgPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Spinner -->
                <ProgressBar IsIndeterminate="True" Width="100" Height="3"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource BgHover}"
                             BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Vide -->
                <TextBlock Text="{DynamicResource RD_NoFavGraphic}"
                           FontSize="12" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="16"
                           Visibility="{Binding HasGraphics, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ListBox ItemsSource="{Binding Graphics}"
                         SelectedItem="{Binding SelectedGraphic, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="False"
                         Visibility="{Binding HasGraphics, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource BgSelected}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FavoriteGraphic}">
                            <DockPanel>
                                <!-- Bouton retirer -->
                                <Button DockPanel.Dock="Right"
                                        Content="🗑" Width="28" Height="28"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Retirer des favoris"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveGraphicCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <!-- Infos -->
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AuthorNames}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding AuthorNames,
                                                   Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ── Séparateur ── -->
            <Border Grid.Column="1" Background="{DynamicResource Border}"/>

            <!-- ── Zone viewer ── -->
            <Grid Grid.Column="2">
                <!-- Placeholder aucune sélection -->
                <TextBlock Text="Sélectionnez un graphique"
                           FontSize="13" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Viewer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- GraphicsViewerView — visible quand Viewer != null -->
                <Border Visibility="{Binding Viewer, Converter={StaticResource NullToVisibility}}">
                    <vrel:GraphicsViewerView DataContext="{Binding Viewer}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
