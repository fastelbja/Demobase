<Window x:Class="DemoBase.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DemoBase.App.ViewModels"
        Title="DemoBase — Initial Setup"
        Width="820" Height="540"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgApp}"
        WindowStyle="None"
        AllowsTransparency="True"
        x:Name="Self">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Étape de la sidebar -->
        <Style x:Key="WizardStepText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <!-- Bordure externe (fenêtre sans chrome) -->
    <Border Background="{DynamicResource BgApp}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Contenu -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>   <!-- Barre boutons -->
            </Grid.RowDefinitions>

            <!-- ═══ SIDEBAR ════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.RowSpan="2"
                    Background="{DynamicResource BgSidebar}"
                    CornerRadius="10,0,0,10">
                <StackPanel Margin="28,36,24,28">

                    <!-- Logo / titre -->
                    <TextBlock Text="DemoBase"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Wiz_SetupTitle}"
                               FontSize="11"
                               Foreground="{DynamicResource Accent}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,32"/>

                    <!-- Liste des étapes -->
                    <ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <!-- Indicateur rond -->
                                    <Border Width="22" Height="22"
                                            CornerRadius="11"
                                            VerticalAlignment="Top"
                                            Margin="0,1,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="{Binding Number}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Text"       Value="✓"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Libellé -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize"   Value="12"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Visibility="{Binding HasSubtitle,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ═══ CONTENU DE L'ÉTAPE ══════════════════════════════════ -->
            <!-- Le déplacement de la fenêtre (drag) est géré par MouseLeftButtonDown
                 dans SetupWizardWindow.xaml.cs, pas via binding XAML. -->
            <Border Grid.Column="1" Grid.Row="0"
                    Padding="48,40,48,24">
                <ContentPresenter Content="{Binding CurrentPageView}"/>
            </Border>

            <!-- ═══ BARRE DE NAVIGATION ════════════════════════════════ -->
            <Border Grid.Column="1" Grid.Row="1"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0"
                    Padding="48,14">
                <DockPanel>
                    <!-- Bouton Annuler à gauche -->
                    <Button DockPanel.Dock="Left"
                            Padding="12,7"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsStepBusy, Converter={x:Static vm:InverseBooleanConverter.Instance}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="{DynamicResource Wiz_Cancel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStepBusy}" Value="True">
                                        <Setter Property="Content" Value="In progress…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Suivant / Terminer à droite -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Padding="12,7" Margin="0,0,8,0"
                                Command="{Binding BackCommand}"
                                IsEnabled="{Binding CanGoBackEnabled}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="{DynamicResource Wiz_Back}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStepBusy}" Value="True">
                                            <Setter Property="Content" Value="In progress…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Padding="18,7"
                                IsEnabled="{Binding IsStepBusy, Converter={x:Static vm:InverseBooleanConverter.Instance}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Content" Value="{DynamicResource Wiz_Next}"/>
                                    <Setter Property="Command" Value="{Binding NextCommand}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource Wiz_Finish}"/>
                                            <Setter Property="Command" Value="{Binding FinishCommand}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStepBusy}" Value="True">
                                            <Setter Property="Content" Value="In progress…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Progression du téléchargement en cours (étape Émulateurs) —
                         occupe l'espace central entre Annuler et Précédent/Suivant,
                         seul emplacement disponible puisque la liste compacte des
                         émulateurs n'a pas la place pour une barre par ligne. -->
                    <Grid Margin="20,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding EmulatorVm.IsDownloadingAny, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,3">
                            <Run Text="{DynamicResource Wiz_Downloading}"/>
                            <Run Text="{Binding EmulatorVm.CurrentDownloadLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding EmulatorVm.CurrentDownloadPercent, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <ProgressBar Grid.Row="1" Height="6"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding EmulatorVm.CurrentDownloadPercent, Mode=OneWay}"/>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
